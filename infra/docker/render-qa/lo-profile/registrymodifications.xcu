<?xml version="1.0" encoding="UTF-8"?>
<oor:items xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
 <item oor:path="/org.openoffice.Office.Common/Security/Scripting"><prop oor:name="MacroSecurityLevel" oor:op="fuse"><value>3</value></prop><prop oor:name="DisableMacrosExecution" oor:op="fuse"><value>true</value></prop></item>
 <item oor:path="/org.openoffice.Office.Impress/Content/Update"><prop oor:name="Link" oor:op="fuse"><value>2</value></prop></item>
 <item oor:path="/org.openoffice.Office.Common/Load"><prop oor:name="UpdateDocMode" oor:op="fuse"><value>0</value></prop></item>
 <item oor:path="/org.openoffice.Office.Common/Misc"><prop oor:name="UseJava" oor:op="fuse"><value>false</value></prop></item>
 <item oor:path="/org.openoffice.Office.Jobs/Jobs/org.openoffice.Office.Jobs:Job['UpdateCheck']/Arguments"><prop oor:name="AutoCheckEnabled" oor:op="fuse"><value>false</value></prop></item>
 <item oor:path="/org.openoffice.Office.Common/Font/Substitution"><prop oor:name="Replacement" oor:op="fuse"><value>true</value></prop></item>
 <item oor:path="/org.openoffice.Office.Common/Font/Substitution/FontPairs">
  <node oor:name="UI" oor:op="replace"><prop oor:name="Font"><value>Yu Gothic UI</value></prop><prop oor:name="ReplaceFont"><value>TA Palt Gothic</value></prop><prop oor:name="Always"><value>true</value></prop><prop oor:name="OnScreenOnly"><value>false</value></prop></node>
  <node oor:name="Gothic" oor:op="replace"><prop oor:name="Font"><value>游ゴシック</value></prop><prop oor:name="ReplaceFont"><value>TA Palt Gothic</value></prop><prop oor:name="Always"><value>true</value></prop><prop oor:name="OnScreenOnly"><value>false</value></prop></node>
  <node oor:name="Arial" oor:op="replace"><prop oor:name="Font"><value>Arial</value></prop><prop oor:name="ReplaceFont"><value>Liberation Sans</value></prop><prop oor:name="Always"><value>true</value></prop><prop oor:name="OnScreenOnly"><value>false</value></prop></node>
  <node oor:name="GothicEnglish" oor:op="replace"><prop oor:name="Font"><value>Yu Gothic</value></prop><prop oor:name="ReplaceFont"><value>TA Palt Gothic</value></prop><prop oor:name="Always"><value>true</value></prop><prop oor:name="OnScreenOnly"><value>false</value></prop></node>
  <node oor:name="GothicLocalized" oor:op="replace"><prop oor:name="Font"><value>游ゴシック体</value></prop><prop oor:name="ReplaceFont"><value>TA Palt Gothic</value></prop><prop oor:name="Always"><value>true</value></prop><prop oor:name="OnScreenOnly"><value>false</value></prop></node>
  <node oor:name="HelveticaNeue" oor:op="replace"><prop oor:name="Font"><value>Helvetica Neue</value></prop><prop oor:name="ReplaceFont"><value>Liberation Sans</value></prop><prop oor:name="Always"><value>true</value></prop><prop oor:name="OnScreenOnly"><value>false</value></prop></node>
 </item>
</oor:items>
