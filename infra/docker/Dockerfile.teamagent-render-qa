# syntax=docker/dockerfile:1.7
# Local/CI only（本番の便には入れない・10-12）。ベースとツールは digest で固定する。
ARG ALPINE_DIGEST=@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc
FROM ${UV_IMAGE} AS uv
FROM public.ecr.aws/docker/library/alpine:3.24${ALPINE_DIGEST} AS packages
COPY infra/docker/render-qa-apk.lock /opt/render-qa-apk.lock
# No floating apk fallback; the placeholder lock deliberately blocks building.
RUN set -eu; \
    test "$(grep -v '^#' /opt/render-qa-apk.lock | grep -c TODO)" -eq 0; \
    apk add --no-cache $(grep -v '^#' /opt/render-qa-apk.lock | grep '=')
COPY --from=uv /uv /usr/local/bin/uv
# uv はイメージの python3（apk・3.14）だけを使う。別の Python をダウンロードさせない。
ENV UV_PYTHON=/usr/bin/python3 UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
FROM packages AS font-builder
RUN uv sync --frozen --only-group render-qa-runtime --only-group render-qa-font-build --no-install-project
COPY infra/docker/render-qa/fonts/build_palt_font.py /opt/build_palt_font.py
# Noto の TTC は font-noto-cjk 0_git20220127-r1 の /usr/share/fonts/noto/（10-12 apk fetch で確認）。
RUN .venv/bin/python /opt/build_palt_font.py \
    --regular /usr/share/fonts/noto/NotoSansCJK-Regular.ttc \
    --bold /usr/share/fonts/noto/NotoSansCJK-Bold.ttc --out /palt-fonts
FROM packages AS runtime
RUN uv sync --frozen --only-group render-qa-runtime --no-install-project
COPY --from=font-builder /palt-fonts /usr/share/fonts/teamagent
COPY infra/docker/render-qa/fontconfig/60-teamagent-substitutes.conf /etc/fonts/conf.d/
COPY infra/docker/render-qa/lo-profile /opt/render-qa/lo-profile
COPY src/teamagent/media/deck_qa.py \
     src/teamagent/media/render_qa.py src/teamagent/media/render_qa_child.py \
     src/teamagent/media/render_qa_thresholds.json \
     src/teamagent/media/render_qa_baseline_proposal_builder_v1.json /app/src/teamagent/media/
RUN mkdir -p /app/src/teamagent; touch /app/src/teamagent/__init__.py /app/src/teamagent/media/__init__.py; \
    fc-cache -f; addgroup -g 10001 renderqa; adduser -D -u 10001 -G renderqa renderqa
ENV PYTHONPATH=/app/src PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 HOME=/tmp XDG_CACHE_HOME=/tmp/cache SAL_DISABLE_CRASH_REPORT=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "teamagent.media.render_qa_child"]
