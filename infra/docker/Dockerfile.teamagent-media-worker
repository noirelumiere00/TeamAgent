# upstream child carries SLSA provenance and the full apk database. We retain
# that database and generate our own final package inventory/SBOM.
FROM 718959508629.dkr.ecr.ap-northeast-1.amazonaws.com/teamagent-mirror/chromium-headless:150-alpine@${CHROMIUM_BASE_ARM64_DIGEST} AS runtime-packages
USER 0

