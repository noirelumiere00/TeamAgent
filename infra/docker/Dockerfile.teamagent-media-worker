# TeamAgent one-shot media worker. The final image intentionally contains no
# core application, E5 model, database client, Slack/OAuth code, or MCP bearer.

ARG CHROMIUM_BASE_ARM64_DIGEST=sha256:ee09ed198c66003a3f15024ca4f8f8613b9a97fdfd0dce8600969fc8a69ecc04
ARG NODE_BUILDER_ARM64_DIGEST=sha256:eef73a25205e27bd016ce672af71560ad6b681142ddf00ff63c7b3098eafcd4d
ARG UV_ARM64_DIGEST=sha256:9941e2d8e06ff884d328905091eac0a6bc1e40e5ce12e6dd0de4ef4ee26baac4

FROM public.ecr.aws/docker/library/node:24-alpine@${NODE_BUILDER_ARM64_DIGEST} AS js-deps
USER 0
WORKDIR /deps

ARG NODE_BUILDER_VERSION=24.18.0
ARG NODE_BUILDER_BINARY_SHA256=5571248503e947b1cbda6ed55f0b3bb5cb0a5f509c941410e5609f1a9a01f34c
ARG NPM_VERSION=11.16.0
ARG NPM_BINARY_SHA256=8e5f6f3429f8cdbe693cdc29904e9d5a7b127a494bd15c804bd54c7403bfcbe7
ARG PLAYWRIGHT_VERSION=1.60.0
ARG PUPPETEER_VERSION=25.3.0
ARG IPADDR_JS_VERSION=2.2.0
ARG PLAYWRIGHT_CORE_NPM_INTEGRITY=sha512-9bW6zvX/m0lEbgTKJ6YppOKx8H3VOPBMOCFh2irXFOT4BbHgrx5hPjwJYLT40Lu+4qtD36qKc/Hn56StUW57IA==
ARG TIKTOK_PACKAGE_JSON_SHA256=c9aafff461749b7591c810d698736fe33461965d238ed2cfd283229612a7fe28
ARG TIKTOK_PACKAGE_LOCK_SHA256=f0fe7ac3f992960d12dfdaddb14fa06e0b44ed92386c2a7d3fc74cbb98784dc2

RUN set -eu; \
    test "$(node --version)" = "v${NODE_BUILDER_VERSION}"; \
    test "$(npm --version)" = "${NPM_VERSION}"; \
    printf '%s  %s\n' "$NODE_BUILDER_BINARY_SHA256" /usr/local/bin/node | sha256sum -c -; \
    printf '%s  %s\n' "$NPM_BINARY_SHA256" /usr/local/bin/npm | sha256sum -c -

COPY tools/tiktok_scraper/package.json tools/tiktok_scraper/package-lock.json ./
RUN --mount=type=cache,id=teamagent-media-npm-arm64,target=/root/.npm,sharing=locked \
    --mount=type=secret,id=teamagent_ca,required=false \
    set -eu; \
    printf '%s  %s\n' "$TIKTOK_PACKAGE_JSON_SHA256" /deps/package.json | sha256sum -c -; \
    printf '%s  %s\n' "$TIKTOK_PACKAGE_LOCK_SHA256" /deps/package-lock.json | sha256sum -c -; \
    playwright_integrity="\"integrity\": \"$PLAYWRIGHT_CORE_NPM_INTEGRITY\""; \
    test "$(grep -F -c "$playwright_integrity" /deps/package-lock.json)" -eq 1; \
    if [ -f /run/secrets/teamagent_ca ]; then \
      cat /etc/ssl/certs/ca-certificates.crt /run/secrets/teamagent_ca \
        > /tmp/teamagent-build-ca.pem; \
      export NODE_EXTRA_CA_CERTS=/tmp/teamagent-build-ca.pem; \
    fi; \
    npm ci --omit=dev --ignore-scripts --no-audit --no-fund; \
    test "$(node -p "require('playwright-core/package.json').version")" = "$PLAYWRIGHT_VERSION"; \
    test "$(node -p "require('puppeteer-core/package.json').version")" = "$PUPPETEER_VERSION"; \
    test "$(node -p "require('ipaddr.js/package.json').version")" = "$IPADDR_JS_VERSION"; \
    rm -f /tmp/teamagent-build-ca.pem

FROM ghcr.io/astral-sh/uv:latest@${UV_ARM64_DIGEST} AS uv

