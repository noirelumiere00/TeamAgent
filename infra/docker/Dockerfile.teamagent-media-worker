RUN --mount=type=cache,id=teamagent-media-apk-arm64,target=/var/cache/apk,sharing=locked \
    --mount=type=secret,id=teamagent_ca,required=false \
    set -eu; \
    cat /etc/ssl/certs/ca-certificates.crt > /tmp/teamagent-build-ca.pem; \
    if [ -f /run/secrets/teamagent_ca ]; then \
      cat /run/secrets/teamagent_ca >> /tmp/teamagent-build-ca.pem; \
    fi; \
    printf '%s/main\n%s/community\n%s/main\n%s/community\n' \
      "$ALPINE_EDGE_REPOSITORY" "$ALPINE_EDGE_REPOSITORY" \
      "$ALPINE_STABLE_REPOSITORY" "$ALPINE_STABLE_REPOSITORY" \
      > /tmp/teamagent-apk-repositories; \
    SSL_CERT_FILE=/tmp/teamagent-build-ca.pem apk \
      --cache-dir /var/cache/apk \
      --cache-max-age 1440 \
      --repositories-file /tmp/teamagent-apk-repositories \
      add \
      "ca-certificates=$CA_CERTIFICATES_PACKAGE_VERSION" \
      "ffmpeg=$FFMPEG_PACKAGE_VERSION" \
      "font-liberation=$FONT_LIBERATION_PACKAGE_VERSION" \
      "font-noto=$FONT_NOTO_PACKAGE_VERSION" \
      "font-noto-cjk=$FONT_NOTO_CJK_PACKAGE_VERSION" \
      "font-noto-emoji=$FONT_NOTO_EMOJI_PACKAGE_VERSION" \
      "libflac=$LIBFLAC_PACKAGE_VERSION" \
      "libssh=$LIBSSH_PACKAGE_VERSION" \
      "mbedtls3=$MBEDTLS3_PACKAGE_VERSION" \
      "nodejs=$NODE_PACKAGE_VERSION" \
      "python3=$PYTHON_PACKAGE_VERSION"; \
    test "$(apk list --installed chromium 2>/dev/null | awk 'NR==1{print $1}')" = "chromium-$CHROMIUM_PACKAGE_VERSION"; \
    test "$(python3 --version)" = "Python $PYTHON_VERSION"; \
    test "$(node --version)" = "v$NODE_VERSION"; \
    ffmpeg -version | head -1 | grep -F "ffmpeg version $FFMPEG_VERSION"; \
    /usr/lib/chromium/chromium --version | grep -F "Chromium $CHROMIUM_VERSION "; \
    printf '%s  %s\n' "$PYTHON_BINARY_SHA256" /usr/bin/python3 | sha256sum -c -; \
    printf '%s  %s\n' "$NODE_BINARY_SHA256" /usr/bin/node | sha256sum -c -; \
    printf '%s  %s\n' "$FFMPEG_BINARY_SHA256" /usr/bin/ffmpeg | sha256sum -c -; \
    printf '%s  %s\n' "$CHROMIUM_BINARY_SHA256" /usr/lib/chromium/chromium | sha256sum -c -; \
    test -s /lib/apk/db/installed; \
    install -d -m 0755 /usr/share/teamagent/provenance; \
    cp /tmp/teamagent-apk-repositories \
      /usr/share/teamagent/provenance/apk-repositories.txt; \
    apk list --installed | awk '{print $1}' | LC_ALL=C sort \
      > /usr/share/teamagent/provenance/apk-installed.lock; \
    sha256sum /usr/bin/python3 /usr/bin/node /usr/bin/ffmpeg \
      /usr/lib/chromium/chromium \
      > /usr/share/teamagent/provenance/runtime-binaries.sha256; \
    rm -f /tmp/teamagent-build-ca.pem /tmp/teamagent-apk-repositories; \
    addgroup -g 10001 teamagent; \
    adduser -D -H -h /tmp/teamagent/home -u 10001 -G teamagent teamagent; \
    chmod 1777 /tmp

FROM runtime-packages AS python-deps
USER 0
WORKDIR /app

ARG UV_VERSION=0.11.29
ARG UV_BINARY_SHA256=f32f61ced7feb20342032cdac4d0825cebbda61911554f5de5231ec72821812e
ARG PLAYWRIGHT_VERSION=1.60.0
ARG PLAYWRIGHT_PYTHON_ARM64_WHEEL_URL=https://files.pythonhosted.org/packages/84/c2/1528d267d4442bd2c6b8eaeab819dd52c2030bf80e89293f0ba1f687473b/playwright-1.60.0-py3-none-manylinux_2_17_aarch64.manylinux2014_aarch64.whl
ARG PLAYWRIGHT_PYTHON_ARM64_WHEEL_SHA256=43e66564125ee31b07a58cefb21e256d62d67d8d1713e6858df7a3019d8ed353
ARG YTDLP_VERSION=2026.7.4
ARG YTDLP_WHEEL_SHA256=f11f2b11d5a8ac4059f9bdf29fa4407dc7c6bb00c5097e95ca22a7a9db518266
ARG YTDLP_SDIST_SHA256=b094813404f87a9dd2186f00815231df32e5fd8a5403be0f807b3bb2d21a4432
ARG YTDLP_SHAHID_SOURCE_SHA256=f82c1f065f6aa3dd5ce8ee3491d4c49f245d1e7ba921b8cc0cc9c8658a634fbd
ARG YTDLP_REMOVED_EXTRACTOR_SET_SHA256=ea414688b508a2a77bf006e5928536603a51e7ab3b8664c13dd6d21b1140b80b
ARG YTDLP_SANITIZED_TREE_SHA256=32a2d7849c3897ae7c28c3e17853b10e3b74a0d280808177c20407496d52e817
ARG YTDLP_SANITIZER_SHA256=4e7464710094be2eb6205fdc1ea207cfe62b99db1b34f9d31691e9a606bcb5db

COPY --from=uv /uv /usr/bin/uv
RUN set -eu; \
    test "$(uv --version)" = "uv ${UV_VERSION} (aarch64-unknown-linux-musl)"; \
    printf '%s  %s\n' "$UV_BINARY_SHA256" /usr/bin/uv | sha256sum -c -

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_SYSTEM_CERTS=true

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,id=teamagent-media-uv-arm64,target=/root/.cache/uv,sharing=locked \
    --mount=type=secret,id=teamagent_ca,required=false \
    set -eu; \
    cat /etc/ssl/certs/ca-certificates.crt > /tmp/teamagent-build-ca.pem; \
    if [ -f /run/secrets/teamagent_ca ]; then \
      cat /run/secrets/teamagent_ca >> /tmp/teamagent-build-ca.pem; \
    fi; \
    export SSL_CERT_FILE=/tmp/teamagent-build-ca.pem; \
    export REQUESTS_CA_BUNDLE=/tmp/teamagent-build-ca.pem; \
    ytdlp_wheel="yt_dlp-${YTDLP_VERSION}-py3-none-any.whl\", hash = \"sha256:$YTDLP_WHEEL_SHA256\""; \
    ytdlp_sdist="yt_dlp-${YTDLP_VERSION}.tar.gz\", hash = \"sha256:$YTDLP_SDIST_SHA256\""; \
    test "$(grep -F -c "$ytdlp_wheel" uv.lock)" -eq 1; \
    test "$(grep -F -c "$ytdlp_sdist" uv.lock)" -eq 1; \
    uv sync --frozen --only-group media-runtime --no-install-project \
      --no-install-package playwright; \
    rm -f /tmp/teamagent-build-ca.pem

# Playwright publishes a manylinux-tagged arm64 wheel whose Python code is
# portable but whose bundled Node is glibc-linked. Verify the original wheel,
# extract it unchanged, then replace only that Node binary with pinned Node 24.
RUN --mount=type=cache,id=teamagent-media-wheel-arm64,target=/var/cache/teamagent,sharing=locked \
    --mount=type=secret,id=teamagent_ca,required=false \
    set -eu; \
    wheel=/var/cache/teamagent/playwright-${PLAYWRIGHT_VERSION}-arm64.whl; \
    cat /etc/ssl/certs/ca-certificates.crt > /tmp/teamagent-build-ca.pem; \
    if [ -f /run/secrets/teamagent_ca ]; then \
      cat /run/secrets/teamagent_ca >> /tmp/teamagent-build-ca.pem; \
    fi; \
    if [ ! -s "$wheel" ] || ! printf '%s  %s\n' \
      "$PLAYWRIGHT_PYTHON_ARM64_WHEEL_SHA256" "$wheel" | sha256sum -c -; then \
      rm -f "$wheel"; \
      SSL_CERT_FILE=/tmp/teamagent-build-ca.pem \
        PLAYWRIGHT_WHEEL_URL="$PLAYWRIGHT_PYTHON_ARM64_WHEEL_URL" \
        PLAYWRIGHT_WHEEL="$wheel" \
        python3 -c "import os, urllib.request; urllib.request.urlretrieve(os.environ['PLAYWRIGHT_WHEEL_URL'], os.environ['PLAYWRIGHT_WHEEL'])"; \
    fi; \
    printf '%s  %s\n' "$PLAYWRIGHT_PYTHON_ARM64_WHEEL_SHA256" "$wheel" | sha256sum -c -; \
    rm -rf /tmp/playwright-wheel; \
    mkdir /tmp/playwright-wheel; \
    python3 -m zipfile -e "$wheel" /tmp/playwright-wheel; \
    site=/app/.venv/lib/python3.14/site-packages; \
    cp -a /tmp/playwright-wheel/playwright "$site/"; \
    cp -a /tmp/playwright-wheel/playwright-${PLAYWRIGHT_VERSION}.dist-info "$site/"; \
    driver_node="$site/playwright/driver/node"; \
    test -f "$driver_node"; \
    rm "$driver_node"; \
    ln -s /usr/bin/node "$driver_node"; \
    test "$(readlink "$driver_node")" = /usr/bin/node; \
    rm -rf /tmp/playwright-wheel /tmp/teamagent-build-ca.pem; \
    /app/.venv/bin/python -m compileall -q "$site/playwright"; \
    test "$(/app/.venv/bin/python -c "import importlib.metadata as m; print(m.version('playwright'))")" = "$PLAYWRIGHT_VERSION"

COPY infra/docker/sanitize_ytdlp.py /tmp/sanitize_ytdlp.py
RUN set -eu; \
    printf '%s  %s\n' "$YTDLP_SANITIZER_SHA256" /tmp/sanitize_ytdlp.py | sha256sum -c -; \
    package_root=/app/.venv/lib/python3.14/site-packages/yt_dlp; \
    test "$(/app/.venv/bin/python -c "import importlib.metadata as m; print(m.version('yt-dlp'))")" = "$YTDLP_VERSION"; \
    python3 /tmp/sanitize_ytdlp.py \
      --package-root "$package_root" \
      --expected-shahid-sha256 "$YTDLP_SHAHID_SOURCE_SHA256" \
      --manifest /usr/share/teamagent/provenance/yt-dlp-sanitization.json; \
    test "$(python3 -c "import json; print(json.load(open('/usr/share/teamagent/provenance/yt-dlp-sanitization.json'))['removed_extractor_set_sha256'])")" = "$YTDLP_REMOVED_EXTRACTOR_SET_SHA256"; \
    test "$(python3 -c "import json; print(json.load(open('/usr/share/teamagent/provenance/yt-dlp-sanitization.json'))['sanitized_source_tree_sha256'])")" = "$YTDLP_SANITIZED_TREE_SHA256"; \
    for name in adultswim aenetworks blackboardcollaborate cloudflarestream \
      espn go nbc shahid tbs vice; do \
      test ! -e "$package_root/extractor/$name.py"; \
      test -z "$(find "$package_root" -type f -iname "$name*.pyc" -print -quit)"; \
    done; \
    /app/.venv/bin/python -c "from yt_dlp.extractor import list_extractor_classes; names={cls.IE_NAME for cls in list_extractor_classes()}; assert not any('shahid' in name.lower() for name in names); assert {'youtube','TikTok','Instagram'} <= names"; \
    uv pip freeze --python /app/.venv/bin/python \
      > /usr/share/teamagent/provenance/python-packages.txt; \
    rm /tmp/sanitize_ytdlp.py /usr/bin/uv

