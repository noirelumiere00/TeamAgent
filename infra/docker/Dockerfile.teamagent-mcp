COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,id=teamagent-core-uv-arm64,target=/root/.cache/uv,sharing=locked \
    --mount=type=secret,id=teamagent_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/teamagent_ca ]; then \
      cat /etc/ssl/certs/ca-certificates.crt /run/secrets/teamagent_ca \
        > /tmp/teamagent-build-ca.pem; \
      export SSL_CERT_FILE=/tmp/teamagent-build-ca.pem; \
      export REQUESTS_CA_BUNDLE=/tmp/teamagent-build-ca.pem; \
    fi; \
    torch_lock="url = \"$TORCH_ARM64_WHEEL_URL\", hash = \"sha256:$TORCH_ARM64_WHEEL_SHA256\""; \
    test "$(grep -F -c "$torch_lock" uv.lock)" -eq 1; \
    uv sync --frozen --no-dev --no-editable --no-install-project \
      --extra mcp --extra embeddings; \
    test "$(/app/.venv/bin/python -c 'import torch; print(torch.__version__)')" = "$TORCH_VERSION"; \
    rm -f /tmp/teamagent-build-ca.pem

