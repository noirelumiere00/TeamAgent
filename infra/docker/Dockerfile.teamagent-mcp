ARG GIT_BRANCH
ARG BUILD_CONTEXT_SHA256
ARG BAKED_APP_HTML_SHA256
ARG BAKED_APP_HTML_VERSION_ID
ARG APP_HTML_SOURCE
ARG APP_HTML_SHA256
ARG APP_HTML_VERSION_ID
ARG APP_HTML_MANIFEST_SHA256
ARG APP_HTML_BUILD_INPUTS_SHA256
ARG RELEASE_CONTRACT_SHA256
ARG RELEASE_APPROVAL_SHA256
ARG APP_PROVENANCE_SHA256
ARG PYTHON_BUILDER_ARM64_DIGEST
ARG PYTHON_RUNTIME_ARM64_DIGEST
ARG UV_ARM64_DIGEST
ARG UV_VERSION
ARG UV_BINARY_SHA256
ARG PYTHON_VERSION
ARG PYTHON_PACKAGE_VERSION
ARG PYTHON_META_APK_SHA256
ARG PYTHON_BASE_APK_SHA256
ARG PYTHON_RUNTIME_APK_SHA256
ARG PYTHON_BASE_DEV_APK_SHA256
ARG PYTHON_DEV_APK_SHA256
ARG PYTHON_BINARY_SHA256
ARG E5_MODEL_REVISION
ARG TORCH_VERSION
ARG TORCH_ARM64_WHEEL_SHA256
ARG BROTLI_PACKAGE_VERSION
ARG BROTLI_COMMON_APK_SHA256
ARG BROTLI_DEC_APK_SHA256
ARG BROTLI_ENC_APK_SHA256
ARG CA_CERTIFICATES_BUNDLE_VERSION
ARG CA_CERTIFICATES_BUNDLE_APK_SHA256
ARG PIP_WHEEL_VERSION
ARG PIP_WHEEL_APK_SHA256
ARG RUNTIME_CONTRACT_SHA256
ARG RUNTIME_RECEIPT_B64
ARG RUNTIME_RECEIPT_SHA256

COPY --from=builder /tmp/core-ca/root/usr/lib/libbrotli*.so.1* /usr/lib/
COPY --from=builder /tmp/core-ca/root/var/lib/db/sbom/libbrotli*-1.2.1-r0.spdx.json /var/lib/db/sbom/
COPY --from=builder /tmp/core-ca/root/etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /tmp/core-ca/root/var/lib/db/sbom/ca-certificates-bundle-20260909-r3.spdx.json /var/lib/db/sbom/ca-certificates-bundle-20260909-r3.spdx.json
COPY --from=builder /tmp/core-ca/root/usr/share/python-wheels/pip-26.2.2-py3-none-any.whl /usr/share/python-wheels/
COPY --from=builder /tmp/core-ca/root/var/lib/db/sbom/py3-pip-wheel-26.2.2-r2.spdx.json /var/lib/db/sbom/
COPY --from=builder /tmp/core-ca/root/usr/lib/apk/db/installed /usr/lib/apk/db/installed
COPY --from=builder /tmp/core-ca/root/usr/bin/ /usr/bin/
COPY --from=builder /tmp/core-ca/root/usr/lib/python3.14/ /usr/lib/python3.14/
COPY --from=builder /tmp/core-ca/root/usr/lib/libpython3.14.so.1.0 /usr/lib/libpython3.14.so.1.0
COPY --from=builder /tmp/core-ca/root/usr/include/python3.14/pyconfig.h /usr/include/python3.14/pyconfig.h
COPY --from=builder /tmp/core-ca/root/var/lib/db/sbom/python-3.14*.spdx.json /var/lib/db/sbom/
# Remove the old library payload/SBOM and prove the new libraries load on glibc.
RUN ["/usr/bin/python3.14", "-c", "from pathlib import Path; import ctypes; [Path('/usr/lib/libbrotli'+part+'.so.1.2.0').unlink() for part in ('common','dec','enc')]; [Path('/var/lib/db/sbom/libbrotli'+part+'1-1.2.0-r5.spdx.json').unlink() for part in ('common','dec','enc')]; assert ctypes.CDLL('libbrotlidec.so.1').BrotliDecoderVersion() == 0x1002001; assert ctypes.CDLL('libbrotlienc.so.1').BrotliEncoderVersion() == 0x1002001"]

# Verify the final scanner inventory and payload; remove the stale base SBOM.
RUN --mount=type=bind,from=builder,source=/tmp/core-ca,target=/tmp/core-ca \
    --mount=type=bind,from=builder,source=/tmp/core-python,target=/tmp/core-python \
    ["/usr/bin/python3.14", "-B", "/tmp/core-ca/replace_core_ca_bundle.py", "finalize", \
     "--root", "/", "--base-db", "/tmp/core-ca/base-installed", \
     "--apk", "/tmp/core-ca/bundle.apk", "--lock", "/tmp/core-ca/lock.json", \
     "--apk-sha256", "4f57ebd7dc21d78ecce228f397d0a4ee46b5cfc777ac5f292821d41a97bfd896", \
     "--version", "20260909-r3", \
     "--apk", "/tmp/core-ca/pip-wheel.apk", "--lock", "/tmp/core-ca/pip-wheel.lock.json", \
     "--apk-sha256", "6dcca154f23de54db689ec2006bb65c67de74d556f55f8836bf5d438da8b8ee1", \
     "--version", "26.2.2-r2", \
     "--apk", "/tmp/core-python/python-3.14-3.14.10_git20261028-r0.apk", "--lock", "/tmp/core-python/core-python-3.14.lock.json", \
     "--apk-sha256", "4b7ab3b38d94407380d50293af9e787a8cae399ac6b83f586b064c2601e18178", "--version", "3.14.10_git20261028-r0", \
     "--apk", "/tmp/core-python/python-3.14-base-3.14.10_git20261028-r0.apk", "--lock", "/tmp/core-python/core-python-3.14-base.lock.json", \
     "--apk-sha256", "b6c799697766e5ba5a8f8f1ace656ac35f8eccb73ccf46fc1f7a4158101e8e4a", "--version", "3.14.10_git20261028-r0", \
     "--apk", "/tmp/core-python/python-3.14-runtime-3.14.10_git20261028-r0.apk", "--lock", "/tmp/core-python/core-python-3.14-runtime.lock.json", \
     "--apk-sha256", "9d2996c75208676b9459b5d022fc1a1ef5e621882353f47989828ab9085446c7", "--version", "3.14.10_git20261028-r0"]

COPY --from=builder /runtime-etc/passwd /etc/passwd
COPY --from=builder /runtime-etc/group /etc/group
COPY --from=builder --chown=10001:10001 /app/ /app/
COPY --from=builder --chown=10001:10001 /runtime-tmp/teamagent/ /tmp/teamagent/

ENV USER=teamagent \
    LOGNAME=teamagent \
    HOME=/tmp/teamagent/home \
    TMPDIR=/tmp/teamagent/tmp \
    XDG_CACHE_HOME=/tmp/teamagent/cache \
    XDG_CONFIG_HOME=/tmp/teamagent/config \
    XDG_DATA_HOME=/tmp/teamagent/data \
    XDG_STATE_HOME=/tmp/teamagent/state \
    VIDEO_APPROVAL_STATE_PATH=/tmp/teamagent/state/video_approval_processed.json \
    MEDIA_JOB_TMP_ROOT=/tmp/teamagent/jobs \
    PATH=/app/.venv/bin:/usr/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/.hf-cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false \
    TEAMAGENT_E5_MODEL_REVISION=$E5_MODEL_REVISION \
    TEAMAGENT_RUNTIME_KIND=core \
    TEAMAGENT_MCP_HOST=0.0.0.0 \
    TEAMAGENT_MCP_PORT=8787 \
    TEAMAGENT_MCP_PATH=/mcp \
    AWS_REGION=ap-northeast-1

LABEL org.opencontainers.image.revision="$GIT_COMMIT" \
      org.opencontainers.image.ref.name="$GIT_BRANCH" \
      io.teamagent.build.context-sha256="$BUILD_CONTEXT_SHA256" \
      io.teamagent.build.release-contract-sha256="$RELEASE_CONTRACT_SHA256" \
      io.teamagent.build.release-approval-sha256="$RELEASE_APPROVAL_SHA256" \
      io.teamagent.build.runtime-contract-sha256="$RUNTIME_CONTRACT_SHA256" \
      io.teamagent.build.runtime-receipt="$RUNTIME_RECEIPT_B64" \
      io.teamagent.build.runtime-receipt-sha256="$RUNTIME_RECEIPT_SHA256" \
      io.teamagent.build.app-provenance-sha256="$APP_PROVENANCE_SHA256" \
      io.teamagent.runtime.kind="core" \
      io.teamagent.runtime.uid="10001" \
      io.teamagent.runtime.gid="10001" \
      io.teamagent.runtime.volume="/tmp" \
      io.teamagent.runtime.contract="fargate-readonly-v1" \
      io.teamagent.contract.brotli-package-version="$BROTLI_PACKAGE_VERSION" \
      io.teamagent.contract.brotli-common-apk-sha256="$BROTLI_COMMON_APK_SHA256" \
      io.teamagent.contract.brotli-dec-apk-sha256="$BROTLI_DEC_APK_SHA256" \
      io.teamagent.contract.brotli-enc-apk-sha256="$BROTLI_ENC_APK_SHA256" \
      io.teamagent.contract.pip-wheel-version="$PIP_WHEEL_VERSION" \
      io.teamagent.contract.pip-wheel-apk-sha256="$PIP_WHEEL_APK_SHA256" \
      io.teamagent.contract.python-version="$PYTHON_VERSION" \
      io.teamagent.contract.python-package-version="$PYTHON_PACKAGE_VERSION" \
      io.teamagent.contract.python-3.14-apk-sha256="$PYTHON_META_APK_SHA256" \
      io.teamagent.contract.python-3.14-base-apk-sha256="$PYTHON_BASE_APK_SHA256" \
      io.teamagent.contract.python-3.14-runtime-apk-sha256="$PYTHON_RUNTIME_APK_SHA256" \
      io.teamagent.contract.python-3.14-base-dev-apk-sha256="$PYTHON_BASE_DEV_APK_SHA256" \
      io.teamagent.contract.python-3.14-dev-apk-sha256="$PYTHON_DEV_APK_SHA256" \
      io.teamagent.contract.python-binary-sha256="$PYTHON_BINARY_SHA256" \
      io.teamagent.contract.python-builder-arm64-digest="$PYTHON_BUILDER_ARM64_DIGEST" \
      io.teamagent.contract.python-runtime-arm64-digest="$PYTHON_RUNTIME_ARM64_DIGEST" \
      io.teamagent.contract.uv-arm64-digest="$UV_ARM64_DIGEST" \
      io.teamagent.contract.uv-version="$UV_VERSION" \
      io.teamagent.contract.uv-binary-sha256="$UV_BINARY_SHA256" \
      io.teamagent.contract.e5-model-revision="$E5_MODEL_REVISION" \
      io.teamagent.contract.torch-version="$TORCH_VERSION" \
      io.teamagent.contract.torch-arm64-wheel-sha256="$TORCH_ARM64_WHEEL_SHA256" \
      io.teamagent.contract.baked-app-html-sha256="$BAKED_APP_HTML_SHA256" \
      io.teamagent.contract.baked-app-html-version-id="$BAKED_APP_HTML_VERSION_ID" \
      io.teamagent.contract.app-html-source="$APP_HTML_SOURCE" \
      io.teamagent.contract.app-html-sha256="$APP_HTML_SHA256" \
      io.teamagent.contract.app-html-version-id="$APP_HTML_VERSION_ID" \
      io.teamagent.contract.app-html-manifest-sha256="$APP_HTML_MANIFEST_SHA256" \
      io.teamagent.contract.app-html-build-inputs-sha256="$APP_HTML_BUILD_INPUTS_SHA256"

USER 10001:10001
VOLUME ["/tmp"]
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=40s \
  CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/healthz', timeout=4).close()"]

ENTRYPOINT []
CMD ["/app/.venv/bin/python", "/app/scripts/run_mcp_http_server.py"]
