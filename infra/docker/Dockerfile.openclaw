# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# OpenClaw gateway for ECS/Fargate (linux/arm64 only).
#
# The official image is used only as a content source. The runtime is a pinned
# distroless Node 24 image: no shell, package manager, curl, npm, or compiler.
# Secrets are injected by ECS at runtime and are never accepted as build args.

ARG OPENCLAW_VERSION=2026.7.1
ARG OPENCLAW_ARM64_DIGEST=sha256:38b611f494cb32e15aaf456d54c6b6be55db9098c90632aed0bfad4a70009707
ARG DISTROLESS_ARM64_DIGEST=sha256:029157d80b0b475dbd9e59715bb1cf51cd637f667ca546b3af39d9ad71bcffd5

# The same pinned upstream image, kept untouched. The stage below prunes /app
# aggressively and removes /app/src, so the workspace templates the runtime
# needs are taken from here instead.
FROM ghcr.io/openclaw/openclaw:${OPENCLAW_VERSION}@${OPENCLAW_ARM64_DIGEST} AS upstream-templates

FROM ghcr.io/openclaw/openclaw:${OPENCLAW_VERSION}@${OPENCLAW_ARM64_DIGEST} AS upstream

USER root

COPY infra/openclaw/openclaw.config.json5 /opt/teamagent/openclaw.source.json5
COPY infra/openclaw/SOUL.md infra/openclaw/HEARTBEAT.md infra/openclaw/IDENTITY.md /opt/teamagent/workspace-seed/
# App Home / DM 初回ウェルカムのビルド時パッチ（中身と理由はスクリプト冒頭コメント参照）。
COPY infra/openclaw/patch-slack-home.mjs /opt/teamagent/patch-slack-home.mjs
COPY infra/openclaw/caller-identity-plugin /opt/teamagent/plugins/teamagent-caller-identity/

# Convert the reviewed JSON5 source into immutable canonical JSON. Runtime
# mutations happen only on a fresh copy under /tmp.
RUN node -e 'const fs=require("fs");const JSON5=require("/app/node_modules/json5");const src="/opt/teamagent/openclaw.source.json5";const out="/opt/teamagent/openclaw.template.json";fs.writeFileSync(out,JSON.stringify(JSON5.parse(fs.readFileSync(src,"utf8")),null,2)+"\n",{mode:0o444});fs.unlinkSync(src)'

# Official plugin artifacts are content-addressed here and also recorded in
# infra/openclaw/plugins-lock.json. Both packages ship npm-shrinkwrap.json and
# their complete production node_modules tree; no mutable npm resolution runs.
ADD --checksum=sha256:d6ae8745867d812560e917707e633c8b66b36f7270124a8cca9602c6dc98ef46 \
    https://registry.npmjs.org/@openclaw/slack/-/slack-2026.7.1.tgz /tmp/openclaw-slack.tgz
ADD --checksum=sha256:4b34630d0a0f715fc9e9cf17166a701c16318abf4b8d04eac1be6455bc917691 \
    https://registry.npmjs.org/@openclaw/amazon-bedrock-provider/-/amazon-bedrock-provider-2026.7.1.tgz /tmp/openclaw-bedrock.tgz

RUN set -eux; \
    mkdir -p /opt/teamagent/plugins/slack /opt/teamagent/plugins/amazon-bedrock; \
    tar -xzf /tmp/openclaw-slack.tgz --strip-components=1 -C /opt/teamagent/plugins/slack; \
    tar -xzf /tmp/openclaw-bedrock.tgz --strip-components=1 -C /opt/teamagent/plugins/amazon-bedrock; \
    test "$(sha256sum /opt/teamagent/plugins/slack/npm-shrinkwrap.json | cut -d' ' -f1)" = "79f3179b6163c1878bef8820673419a0547027c536666e482b02bd8ae5a7980c"; \
    test "$(sha256sum /opt/teamagent/plugins/amazon-bedrock/npm-shrinkwrap.json | cut -d' ' -f1)" = "1580dc988ec8ef3e430a166274062ddde547a75f9e338d00905021ebb283f31e"; \
    node /opt/teamagent/patch-slack-home.mjs /opt/teamagent/plugins/slack/dist; \
    node --check /opt/teamagent/plugins/slack/dist/provider-*.js; \
    node -e 'const fs=require("fs");const checks=[["/opt/teamagent/plugins/slack/package.json","@openclaw/slack","2026.7.1",true],["/opt/teamagent/plugins/amazon-bedrock/package.json","@openclaw/amazon-bedrock-provider","2026.7.1",true],["/opt/teamagent/plugins/teamagent-caller-identity/package.json","@teamagent/openclaw-caller-identity","1.0.0",false]];for(const [p,n,v,official] of checks){const x=JSON.parse(fs.readFileSync(p));if(x.name!==n||x.version!==v||(official&&x.peerDependencies?.openclaw!==">=2026.7.1"))throw new Error(`plugin contract mismatch: ${n}`)}'; \
    ln -s /app /opt/teamagent/plugins/slack/node_modules/openclaw; \
    ln -s /app /opt/teamagent/plugins/amazon-bedrock/node_modules/openclaw; \
    mkdir -p /tmp/teamagent-openclaw/config /tmp/teamagent-openclaw/state /tmp/teamagent-openclaw/home /opt/teamagent/state-seed; \
    cp /opt/teamagent/openclaw.template.json /tmp/teamagent-openclaw/config/openclaw.json; \
    HOME=/tmp/teamagent-openclaw/home OPENCLAW_STATE_DIR=/tmp/teamagent-openclaw/state OPENCLAW_CONFIG_PATH=/tmp/teamagent-openclaw/config/openclaw.json TEAMAGENT_CALLER_CLAIM_SECRET=build-placeholder-caller-claim-secret-32-bytes SLACK_TEAM_ID=T0123456789 node /app/openclaw.mjs plugins install --link /opt/teamagent/plugins/slack >/dev/null; \
    HOME=/tmp/teamagent-openclaw/home OPENCLAW_STATE_DIR=/tmp/teamagent-openclaw/state OPENCLAW_CONFIG_PATH=/tmp/teamagent-openclaw/config/openclaw.json TEAMAGENT_CALLER_CLAIM_SECRET=build-placeholder-caller-claim-secret-32-bytes SLACK_TEAM_ID=T0123456789 node /app/openclaw.mjs plugins install --link /opt/teamagent/plugins/amazon-bedrock >/dev/null; \
    HOME=/tmp/teamagent-openclaw/home OPENCLAW_STATE_DIR=/tmp/teamagent-openclaw/state OPENCLAW_CONFIG_PATH=/tmp/teamagent-openclaw/config/openclaw.json TEAMAGENT_CALLER_CLAIM_SECRET=build-placeholder-caller-claim-secret-32-bytes SLACK_TEAM_ID=T0123456789 node /app/openclaw.mjs plugins install --link /opt/teamagent/plugins/teamagent-caller-identity >/dev/null; \
    cp /tmp/teamagent-openclaw/state/state/openclaw.sqlite /opt/teamagent/state-seed/openclaw.sqlite; \
    node -e 'const {DatabaseSync}=require("node:sqlite");const db=new DatabaseSync("/opt/teamagent/state-seed/openclaw.sqlite");db.exec("DELETE FROM config_health_entries");db.close()'; \
    rm -rf /tmp/teamagent-openclaw; \
    rm -f /tmp/openclaw-slack.tgz /tmp/openclaw-bedrock.tgz; \
    rm -rf /root/.cache/ms-playwright /home/node/.cache/ms-playwright /ms-playwright; \
    chmod -R a-w /opt/teamagent

# The pinned upstream release ships five transitively vulnerable packages that
# the release gate rejects (it requires zero Critical/High findings). Upstream
# has no patched tag for 2026.7.1, so exact-version registry tarballs are unpacked
# over only the affected directories here. Running npm pack from /tmp avoids the
# /app workspace root and does not resolve or mutate the rest of the dependency
# closure. The prune pass immediately below must run after these tarballs are
# unpacked so their development metadata and payload are removed before the
# runtime inventory check. The assertions below fail the build if a tarball
# contains anything other than the reviewed version.
#   axios           1.16.0 -> 1.18.0  GHSA-gcfj-64vw-6mp9 (inherited proxy)
#   brace-expansion 5.0.7  -> 5.0.9   CVE-2026-69152
#   fast-uri        3.1.2  -> 3.1.5   CVE-2026-18446
#   ip-address      10.2.0 -> 10.3.1  CVE-2026-69192
#   undici          8.5.0  -> 8.9.0   CVE-2026-13697
# Every axios release that carries the GHSA-gcfj-64vw-6mp9 fix (1.16.1 and later)
# also declares a new production dependency on https-proxy-agent ^5.0.1, so its
# closure has to be completed here or the prune resolver fails on an unresolved
# requirement. No node_modules directory exists above the Slack plugin, so the
# /app copies (https-proxy-agent 7.0.6, agent-base 7.1.4) are unreachable from
# axios and would not satisfy the ^5.0.1 range anyway. debug 4.4.3 and ms 2.1.3
# already sit beside axios and are reused. Both added packages carry zero known
# advisories, so the zero-Critical/High gate is unaffected.
#   https-proxy-agent 5.0.1 (new)     required by axios 1.18.0
#   agent-base        6.0.2 (new)     required by https-proxy-agent 5.0.1
RUN set -eux; \
    chmod -R u+w /opt/teamagent; \
    patch_dir=/tmp/openclaw-vulnerability-patches; \
    mkdir -p "$patch_dir"; \
    cd "$patch_dir"; \
    npm pack axios@1.18.0 --ignore-scripts --pack-destination "$patch_dir"; \
    npm pack brace-expansion@5.0.9 --ignore-scripts --pack-destination "$patch_dir"; \
    npm pack fast-uri@3.1.5 --ignore-scripts --pack-destination "$patch_dir"; \
    npm pack ip-address@10.3.1 --ignore-scripts --pack-destination "$patch_dir"; \
    npm pack undici@8.9.0 --ignore-scripts --pack-destination "$patch_dir"; \
    npm pack https-proxy-agent@5.0.1 --ignore-scripts --pack-destination "$patch_dir"; \
    npm pack agent-base@6.0.2 --ignore-scripts --pack-destination "$patch_dir"; \
    rm -rf \
      /opt/teamagent/plugins/slack/node_modules/axios \
      /opt/teamagent/plugins/slack/node_modules/https-proxy-agent \
      /opt/teamagent/plugins/slack/node_modules/agent-base \
      /app/node_modules/brace-expansion \
      /app/node_modules/fast-uri \
      /app/node_modules/ip-address \
      /app/node_modules/undici; \
    mkdir -p \
      /opt/teamagent/plugins/slack/node_modules/axios \
      /opt/teamagent/plugins/slack/node_modules/https-proxy-agent \
      /opt/teamagent/plugins/slack/node_modules/agent-base \
      /app/node_modules/brace-expansion \
      /app/node_modules/fast-uri \
      /app/node_modules/ip-address \
      /app/node_modules/undici; \
    tar -xzf "$patch_dir/axios-1.18.0.tgz" --strip-components=1 -C /opt/teamagent/plugins/slack/node_modules/axios; \
    tar -xzf "$patch_dir/https-proxy-agent-5.0.1.tgz" --strip-components=1 -C /opt/teamagent/plugins/slack/node_modules/https-proxy-agent; \
    tar -xzf "$patch_dir/agent-base-6.0.2.tgz" --strip-components=1 -C /opt/teamagent/plugins/slack/node_modules/agent-base; \
    tar -xzf "$patch_dir/brace-expansion-5.0.9.tgz" --strip-components=1 -C /app/node_modules/brace-expansion; \
    tar -xzf "$patch_dir/fast-uri-3.1.5.tgz" --strip-components=1 -C /app/node_modules/fast-uri; \
    tar -xzf "$patch_dir/ip-address-10.3.1.tgz" --strip-components=1 -C /app/node_modules/ip-address; \
    tar -xzf "$patch_dir/undici-8.9.0.tgz" --strip-components=1 -C /app/node_modules/undici; \
    cd /tmp; \
    rm -rf "$patch_dir"; \
    node -e 'const fs=require("fs");const want={"/app/node_modules/brace-expansion":"5.0.9","/app/node_modules/fast-uri":"3.1.5","/app/node_modules/ip-address":"10.3.1","/app/node_modules/undici":"8.9.0","/opt/teamagent/plugins/slack/node_modules/agent-base":"6.0.2","/opt/teamagent/plugins/slack/node_modules/axios":"1.18.0","/opt/teamagent/plugins/slack/node_modules/https-proxy-agent":"5.0.1"};for(const [dir,v] of Object.entries(want)){const got=JSON.parse(fs.readFileSync(dir+"/package.json")).version;if(got!==v)throw new Error(`vulnerability patch mismatch: ${dir} is ${got}, expected ${v}`)}'; \
    chmod -R a-w /opt/teamagent

# The upstream release contains its complete development workspace. Resolve the
# production dependency closure, prune browser registration/CLI chunks that are
# unreachable from the real entry points, and physically remove source
# compilers, tests, fixtures, type sources, source maps, and package CLIs.
# A machine-readable reachability/pruning report is retained in the image.
COPY infra/openclaw/prune-runtime.mjs /tmp/prune-runtime.mjs
RUN node /tmp/prune-runtime.mjs && rm -f /tmp/prune-runtime.mjs

# Rebuild the persisted plugin registry after pruning so its source hashes and
# extension inventory describe the final runtime, not the upstream workspace.
RUN set -eux; \
    mkdir -p /tmp/teamagent-openclaw/config /tmp/teamagent-openclaw/state/state /tmp/teamagent-openclaw/home; \
    cp /opt/teamagent/openclaw.template.json /tmp/teamagent-openclaw/config/openclaw.json; \
    cp /opt/teamagent/state-seed/openclaw.sqlite /tmp/teamagent-openclaw/state/state/openclaw.sqlite; \
    HOME=/tmp/teamagent-openclaw/home \
      OPENCLAW_STATE_DIR=/tmp/teamagent-openclaw/state \
      OPENCLAW_CONFIG_PATH=/tmp/teamagent-openclaw/config/openclaw.json \
      SLACK_BOT_TOKEN=build-placeholder \
      SLACK_APP_TOKEN=build-placeholder \
      OPENCLAW_GATEWAY_TOKEN=build-placeholder \
      TEAMAGENT_MCP_BEARER=build-placeholder \
      TEAMAGENT_CALLER_CLAIM_SECRET=build-placeholder-caller-claim-secret-32-bytes \
      SLACK_TEAM_ID=T0123456789 \
      node /app/openclaw.mjs plugins registry --refresh >/dev/null; \
    node -e 'const {DatabaseSync}=require("node:sqlite");const db=new DatabaseSync("/tmp/teamagent-openclaw/state/state/openclaw.sqlite");db.exec("DELETE FROM config_health_entries");db.close()'; \
    cp /tmp/teamagent-openclaw/state/state/openclaw.sqlite /opt/teamagent/state-seed/openclaw.sqlite; \
    rm -rf /tmp/teamagent-openclaw; \
    chmod -R a-w /opt/teamagent

FROM gcr.io/distroless/nodejs24-debian13:nonroot@${DISTROLESS_ARM64_DIGEST} AS runtime

ARG OPENCLAW_VERSION=2026.7.1
ARG OPENCLAW_ARM64_DIGEST=sha256:38b611f494cb32e15aaf456d54c6b6be55db9098c90632aed0bfad4a70009707
ARG DISTROLESS_ARM64_DIGEST=sha256:029157d80b0b475dbd9e59715bb1cf51cd637f667ca546b3af39d9ad71bcffd5
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG SOURCE_TREE=unknown
ARG SOURCE_URI=https://github.com/noirelumiere00/TeamAgent.git
ARG SOURCE_ARCHIVE_SHA256=unknown
ARG SOURCE_ARTIFACT_VERSION=unknown
ARG PLUGINS_LOCK_SHA256=unknown
ARG RELEASE_CONTRACT_SHA256=unknown

COPY --from=upstream --chown=65532:65532 /app/dist /app/dist
COPY --from=upstream --chown=65532:65532 /app/node_modules /app/node_modules
COPY --from=upstream --chown=65532:65532 /app/openclaw.mjs /app/openclaw.mjs
COPY --from=upstream --chown=65532:65532 /app/package.json /app/package.json
COPY --from=upstream --chown=65532:65532 /app/skills /app/skills
# Workspace templates are runtime data, not documentation. dist resolves them as
# <package root>/src/agents/templates first and falls back to
# <package root>/docs/reference/templates, so both must ship or the gateway
# starts and reports healthy but fails on the first message with
# "Missing workspace template: AGENTS.md". HEARTBEAT.md is worse: it is only
# ever read from the primary directory, so the src copy is not optional.
# These come from the untouched upstream layer because the pruning stage deletes
# /app/src entirely, and they are pinned to the same digest as that stage.
COPY --from=upstream-templates --chown=65532:65532 \
  /app/src/agents/templates /app/src/agents/templates
COPY --from=upstream-templates --chown=65532:65532 \
  /app/docs/reference/templates /app/docs/reference/templates
COPY --from=upstream --chown=65532:65532 /opt/teamagent /opt/teamagent
COPY --chown=65532:65532 --chmod=0555 infra/docker/openclaw-entrypoint.mjs /opt/teamagent/entrypoint.mjs
COPY --chown=65532:65532 --chmod=0555 infra/openclaw/gateway-runtime.mjs /opt/teamagent/gateway-runtime.mjs
COPY --chown=65532:65532 --chmod=0555 infra/openclaw/rollout-task-canary.mjs /opt/teamagent/rollout-task-canary.mjs
COPY --chown=65532:65532 --chmod=0444 infra/openclaw/effective-tool-scope.json /opt/teamagent/effective-tool-scope.json

ENV NODE_ENV=production \
    PATH=/nodejs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/tmp/teamagent-openclaw/home \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/teamagent-openclaw/cache \
    NODE_COMPILE_CACHE=/tmp/teamagent-openclaw/node-compile-cache \
    OPENCLAW_RUNTIME_DIR=/tmp/teamagent-openclaw \
    OPENCLAW_STATE_DIR=/tmp/teamagent-openclaw/state \
    OPENCLAW_WORKSPACE_DIR=/tmp/teamagent-openclaw/state/workspace \
    OPENCLAW_CONFIG_PATH=/tmp/teamagent-openclaw/config/openclaw.json \
    AWS_REGION=ap-northeast-1 \
    TEAMAGENT_BUILD_COMMIT=${GIT_COMMIT} \
    TEAMAGENT_BUILD_BRANCH=${GIT_BRANCH}

LABEL org.opencontainers.image.title="TeamAgent OpenClaw Gateway" \
      org.opencontainers.image.source="${SOURCE_URI}" \
      org.opencontainers.image.version="${OPENCLAW_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.base.name="gcr.io/distroless/nodejs24-debian13:nonroot" \
      org.opencontainers.image.base.digest="${DISTROLESS_ARM64_DIGEST}" \
      io.teamagent.source.branch="${GIT_BRANCH}" \
      io.teamagent.source.tree="${SOURCE_TREE}" \
      io.teamagent.source.archive.sha256="${SOURCE_ARCHIVE_SHA256}" \
      io.teamagent.source.artifact.version="${SOURCE_ARTIFACT_VERSION}" \
      io.teamagent.openclaw.upstream.digest="${OPENCLAW_ARM64_DIGEST}" \
      io.teamagent.openclaw.plugins-lock.sha256="${PLUGINS_LOCK_SHA256}" \
      io.teamagent.build.contract-sha256="${RELEASE_CONTRACT_SHA256}" \
      io.teamagent.runtime.kind="core" \
      io.teamagent.runtime.architecture="linux/arm64" \
      io.teamagent.runtime.readonly-rootfs-required="true"

WORKDIR /app
USER 65532:65532
# ECS/Fargate copies this path's image ownership/mode into a task-scoped bind
# volume when the task mounts the same containerPath. /tmp is 01777 in the
# distroless base, so uid 65532 can write while the root filesystem stays RO.
VOLUME ["/tmp"]
ENTRYPOINT ["/nodejs/bin/node", "/opt/teamagent/entrypoint.mjs"]
CMD ["/opt/teamagent/gateway-runtime.mjs", "gateway", "--bind", "loopback", "--port", "18789"]
