{
  "schema_version": "1",
  "architecture": "linux/arm64",
  "runtime_consumers": "infra/docker/runtime-consumers.json",
  "security_gates": {
    "trivy": {
      "critical_vulnerabilities": 0,
      "high_vulnerabilities": 0,
      "secrets": 0,
      "allow_suppressions": false,
      "ignore_unfixed": false,
      "required_absent_live_cves": [
        "CVE-2026-5450",
        "CVE-2026-13221",
        "CVE-2026-12087",
        "CVE-2026-57433"
      ],
      "scanner_receipt_fields": [
        "scan_started_at",
        "scan_finished_at",
        "trivy_version",
        "vulnerability_db_version",
        "vulnerability_db_updated_at",
        "vulnerability_db_downloaded_at",
        "vulnerability_db_next_update",
        "secret_check_bundle_digest"
      ]
    },
    "ecr_basic_scan": {
      "critical_vulnerabilities": 0,
      "high_vulnerabilities": 0,
      "required_after_authorized_push": true,
      "fail_closed_until_complete": true
    },
    "release_promotion": {
      "image_reference": "ecr-digest-only",
      "release_gate_decision": "ACCEPTED",
      "release_gate_sha256_required": true,
      "required_gates": [
        "local_runtime_evidence",
        "ecr_basic_scan",
        "fargate_runtime_smoke"
      ],
      "additional_required_gates_allowed": true
    },
    "local_evidence": {
      "credential_scope": "local-source-validation-only-not-release-credential",
      "source": "exact-git-archive",
      "build_context": "retained-exact-materialized-context",
      "source_tree_sha256_required": true,
      "context_tree_sha256_required": true,
      "review_base_oid_required": true,
      "merge_base_oid_required": true,
      "base_head_change_list_required": true,
      "supplemental_grype": {
        "version": "0.112.0",
        "immutable_image_subject_required": true,
        "database_status_required": true,
        "suppressed_findings": 0,
        "promotion_credential": false
      },
      "retained_final_verification": "FINAL_VERIFICATION.json",
      "final_verification_checks_completed_sha256sums": true
    }
  },
  "media_jobs": {
    "schema_version": "1",
    "maximum_envelope_bytes": 131072,
    "maximum_ecs_override_characters": 8192,
    "ecs_payload_transport": "dynamodb-job-id-and-payload-sha256-pointer",
    "idempotency_identity": "semantic-request-sha256-excluding-envelope-timestamps",
    "deadline_budget": "single-absolute-epoch-propagated-with-remaining-time",
    "maximum_deadline_seconds": 900,
    "acquire_host_suffixes": [
      "youtube.com",
      "youtu.be",
      "tiktok.com",
      "instagram.com",
      "instagr.am"
    ],
    "minimum_artifact_ttl_seconds": 300,
    "maximum_artifact_ttl_seconds": 21600,
    "authoritative_cleanup": "owner-version-fenced-scheduled-janitor",
    "lifecycle_backstop_days": 1,
    "worker_failure_cleanup_scope": "owned-attempt-only",
    "synchronous_consumer_deletes_shared_state": false
  },
  "tasks": {
