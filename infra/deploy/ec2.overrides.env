# ============================================================
# EC2 worker 専用の環境変数オーバーライド
# ============================================================
# scripts/deploy_to_ec2.sh が `.env.production` の後ろに連結して
# `teamagent.env.base` を生成する。シェルの後勝ちで、ここの値が本番設定を上書きする。
#
# 鉄則: ここには **秘密値を書かない**（CLAUDE.md 6-bis）。
#       実値（DBパスワード/Slackトークン/SA JSON）は Secrets Manager から
#       scripts/load_secrets.sh が起動時に展開する。ここは *_SECRET_NAME とパスのみ。
# ============================================================

# --- RDS: VPC 内から直結（Mac の SSM トンネル localhost:15432 ではない）---
RDS_HOST=teamagent-dev.c164uq6g8u35.ap-northeast-1.rds.amazonaws.com
RDS_PORT=5432

# --- Gemini(Vertex) の SA JSON: EC2 ローカルに materialize ---
# 実体は Secrets Manager(VERTEX_SA_SECRET_NAME) から load_secrets.sh が umask 077 で書き出す。
# .env.production の Mac 絶対パスを上書きする。
GOOGLE_APPLICATION_CREDENTIALS=/opt/teamagent/secrets/vertex-sa.json
VERTEX_SA_PATH=/opt/teamagent/secrets/vertex-sa.json
VERTEX_SA_SECRET_NAME=teamagent/dev/vertex_sa

# --- メール/Workspace 連携（per-user OAuth）---
# これらが無いと EC2 Bot でも連携が「沈黙故障」する（OAUTH_KMS_KEY_ID 未設定 →
# TokenStore が InMemory に落ち全員未連携 / OAUTH_REDIRECT_URI 未設定 → 連携リンク生成不可）。
# OAUTH_STATE_SECRET は秘密なので平文禁止 → Secrets Manager 経由（_SECRET_NAME のみ記載）。
# Bot(make_state) と connect_web(verify_state) で同一値を共有する必要がある。
OAUTH_REDIRECT_URI=https://esk97z9grh.execute-api.ap-northeast-1.amazonaws.com/oauth2/callback
OAUTH_KMS_KEY_ID=alias/teamagent-oauth-tokens
OAUTH_KMS_REGION=ap-northeast-1
OAUTH_STATE_SECRET_NAME=teamagent/dev/oauth_state_secret
# connect_web は ALB から到達させるため 0.0.0.0 待受にする（既定 127.0.0.1 では ALB 不達）。
CONNECT_WEB_HOST=0.0.0.0
CONNECT_WEB_PORT=8788

# --- TikTok スクレイパ(Puppeteer)の Chrome ---
# CHROMIUM_PATH は Chrome のバージョン依存パスなのでデプロイ時に find して追記される
# （deploy_to_ec2.sh が `find /opt/teamagent/chrome -name chrome` で解決）。
# node は user_data で導入済み（PATH 上）なので TIKTOK_NODE_BIN は不要。

# --- 同時実行チューニング（想定: 20名ログイン → 最大4名が同時にAI機能）---
# 設計値「同時≤4並列・超過はFIFOキュー」。キュー満杯/待ち過ぎはユーザーに明示通知。
REQUEST_GATE_CONCURRENCY=4          # 同時に重い処理(検索/分析等)を走らせる上限
REQUEST_GATE_QUEUE_MAX=64           # 超過分の待機キュー長（満杯は「混雑中」で即時拒否）
REQUEST_GATE_ACQUIRE_TIMEOUT_S=120  # キュー待ちの上限秒。無限待ちを避け「順番待ちが長い」通知を発火
RUNTIME_EXECUTOR_WORKERS=24         # skill.run を逃がす default ThreadPool 幅（gate4＋動画内部並列を吸収）

# --- CPU 推論(e5 embed)の BLAS スレッド抑制（t4g.medium=2vCPU 想定）---
# 1スレッドに寄せ、並列は gate/executor 側で稼ぐ。4 並列 embed の CPU オーバーサブスクリプション防止。
# ※ torch は import 時にこれを読むため、プロセス起動“前”に環境へ載せる（EnvironmentFile 経由で有効）。
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1

# --- 堅牢化（障害時のハング連鎖・OOM 防止）---
# DB タイムアウト: RDS 再起動/AZ障害時の TCP ハング(分単位)とハングクエリのプール占有を遮断。
PG_CONNECT_TIMEOUT_S=5          # 新規接続の確立タイムアウト秒
PG_STATEMENT_TIMEOUT_MS=30000  # 1文の実行上限ms（ingest の大きめ UPSERT も収まる値）
PG_LOCK_TIMEOUT_MS=5000        # ロック待ちの上限ms
PG_IDLE_TX_TIMEOUT_MS=30000    # トランザクション放置の上限ms
# 動画アップロード処理(gate外)の同時本数上限。多人数同時アップ時の OOM/帯域/Vertex スロットル防止。
VIDEO_UPLOAD_CONCURRENCY=2
# Gemini(Vertex) の一過性エラー(429/503/timeout)リトライ回数（初回含む総試行）。
GEMINI_RETRY_MAX_ATTEMPTS=3
