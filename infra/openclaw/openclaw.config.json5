// OpenClaw 設定テンプレ（~/.openclaw/openclaw.json にマウント / perm 600・Git レビュー必須）
// JSON5（コメント可）。★ 秘密値は書かない。${VAR}（英大文字）で注入された環境変数を参照するだけ。
//
// 設計意図（§A 一次ソース確認に基づく）:
//  - tool を最小化し、exec/shell/fs/browser を構造的に塞ぐ → 2026-05-28 の exec/shell 系 CVE 群を無効化。
//  - 営業データには直接触れず、能力は「Slack受け」「Bedrock推論」「review済みteamagent MCP tool」だけ。
//  - MCP scopeには読取だけでなく、Gmail下書き保存、本人Calendar書込、Slackファイル配信、
//    外部job/S3 report生成も含む。メール送信・招待送信・Drive書込は含まない。
//  - per-user 認可は OpenClaw でなく MCP 境界内で行う。trusted Slack event由来の署名caller
//    claimを内部pluginがtool実行直前に注入し、LLM申告user_id単体は認可に使わない。
{
  // ── エージェント／ペルソナ ───────────────────────────────────────────────
  agents: {
    defaults: {
      // P1 はプロアクティブ無効（heartbeat 0m）。プロアクティブは P2/WS-D で HEARTBEAT.md と共に解禁。
      heartbeat: { every: "0m" },
      // §O: Fargate に docker socket は無い（backend:"docker" は local daemon 必須＝公式）ため off。
      // 多層防御は tools.profile:minimal / native deny / exec deny / fs workspaceOnly / browser off /
      // toolFilter / readonly rootfs / IAM Deny / SG で維持（sandbox は元々「万一の追加層」）。
      sandbox: { mode: "off" },
      // §O: cacheRetention の明示パラメータは Bedrock 公式 doc に記載なし(unverified)のため
      // 削除して既定挙動に。★prompt caching チューニングは P1 実測後に再評価（§D）。
    },
    list: [
      {
        id: "teamagent",
        default: true,
        // §D: 外側ループ=Haiku4.5（ツール判断＋最終整形＝速い/安い）。重い合成は MCP 境界内(L2)に任せる。
        // §O: 公式は provider/model 記法（amazon-bedrock/ プレフィックス必須）。
        // §P: ID は list-inference-profiles の実測値で確定（2026-06-11・account 718959508629/東京）。
        model: "amazon-bedrock/jp.anthropic.claude-haiku-4-5-20251001-v1:0",
        identity: { name: "TeamAgent", emoji: "🧭" },
        // §S: skipBootstrap は v2026.6.1 schema の agents.list[] に無い（config validate で弾かれた）ため削除。
        // レビュー済み SOUL.md/HEARTBEAT.md は entrypoint が workspace に seed 済み。
      },
    ],
  },

  // ── プラグイン（公式同版2点 + repo-source-bound caller identity 1点） ───────
  // allow を明示して、バンドル済みでも不要なプラグインはロードしない。
  // 公式2点のtarball/shrinkwrap hashはDockerfile+plugins-lock、internal pluginはsource treeで固定。
  plugins: {
    allow: ["slack", "amazon-bedrock", "teamagent-caller-identity"],
    load: {
      paths: [
        "/opt/teamagent/plugins/slack",
        "/opt/teamagent/plugins/amazon-bedrock",
        "/opt/teamagent/plugins/teamagent-caller-identity",
      ],
    },
    entries: {
      slack: { enabled: true },
      "amazon-bedrock": { enabled: true },
      "teamagent-caller-identity": {
        enabled: true,
        // Pre-model context cross-checks direct inbound runId bindings and
        // fail-closed legacy correlation. The reviewed plugin ignores prompts.
        hooks: { allowConversationAccess: true },
      },
    },
  },

  // ── Slack 接続（§O: channels.slack の config 宣言が必須＝公式。env 注入だけでは立ち上がらない） ──
  // トークン値は書かない: ${VAR} は ECS secrets（fargate.tf の SLACK_BOT_TOKEN/SLACK_APP_TOKEN）で注入。
  channels: {
    slack: {
      enabled: true,
      mode: "socket", // Socket Mode（公開エンドポイント不要・outbound WebSocket のみ）
      botToken: "${SLACK_BOT_TOKEN}",
      appToken: "${SLACK_APP_TOKEN}",
      // §S: groupPolicy 既定は "allowlist"（許可ch未設定だと無応答）。P1は招待された専用chで
      // 応答させるため "open"（botが居るchでのみ反応・到達範囲は招待で限定）。
      groupPolicy: "open",
      // §T1: 返信はスレッドに付ける（既定 off＝chに平打ち・ユーザー要望2026-06-12）。
      // ch/グループ=全返信スレッド化・DM=平打ち（DMにスレッドは不自然）。docs/channels/slack で一次確認。
      replyToModeByChatType: { channel: "all", group: "all", direct: "off" },
      // §T1: 受付リアクション（処理中が見える＝「無視された？」を防ぐ実運用の詰まり潰し）。
      ackReaction: "eyes",
      // 焼込みtemplateは全社内開放のschema-validな組（open + ["*"]）。ただし本番は
      // SLACK_DM_ALLOWLISTの明示指定が必須で、entrypointは空/未設定を焼込み値へfallbackせずexit 78にする。
      // envが"*"ならこの組を維持し、個別のU... ID群ならdmPolicyを"allowlist"へ切り替え、
      // allowFromを指定順のexact IDsへ同時に置換する。wildcardとIDの混在は許可しない。
      dmPolicy: "open",
      // OpenClaw 2026.7.1の実schemaはopenに["*"]、allowlistに非空allowFromを要求する。
      // 実behaviorもallowlistでは一致IDだけを許可するため、entrypointの変換と同じ契約になる。
      allowFrom: [
        "*",
      ],
    },
  },

  // ── セッション分離（多人数で会話が混ざらないように／§D・既定 main は Alice↔Bob 漏れる) ──
  session: { dmScope: "per-channel-peer" },

  // ── L0 コンテキスト直近N件制限（v0.3 Task10・§2.1 FinOps F1） ─────────────────
  // 司令塔ループのプロンプトへ含める会話履歴を直近 20 件に制限し、長文スレッドでの
  // トークンコスト線形増を止める（v0.3 設計書の初期値 10〜上限 20 の保守側）。
  // キーは公式 config 例（docs.openclaw.ai/gateway/configuration-examples）の現行スキーマに
  // 実在する messages.groupChat.historyLimit。⚠️ 本番 2026.6.5 での受理は起動時 config
  // validate が最終判定（未知キーは exit78 で起動拒否＝§S 実測）。デプロイ後の run-task
  // 検証で bot 起動を必ず確認し、reject されたら本節を外して再ビルド（=upstream 版上げ待ち）。
  messages: {
    groupChat: { historyLimit: 20 },
  },

  // ── tool ポリシー（最小権限＝攻撃面の縮小） ───────────────────────────────
  tools: {
    // minimal alone contains session_status and hides MCP. Add only bundle-mcp,
    // then explicitly deny every native message/filesystem/session bypass.
    profile: "minimal",
    alsoAllow: ["bundle-mcp"],
    deny: [
      "message",
      "read", "write", "edit", "apply_patch", "send", "delete", "upload",
      "sessions_list", "sessions_history", "sessions_send",
      "sessions_spawn", "sessions_yield", "subagents", "session_status",
    ],
    exec: { mode: "deny", applyPatch: { workspaceOnly: true } }, // host コマンド実行を禁止
    fs: { workspaceOnly: true },
    // 危険な外部安全バイパスは一切使わない（既定 false のまま）。
    sandbox: {
      // sandbox セッションでもreview済みMCP scopeだけは見せる（bundle-mcpを許可）。
      tools: { alsoAllow: ["bundle-mcp"] },
    },
  },

  // ── ゲートウェイ（ローカル限定） ─────────────────────────────────────────
  gateway: {
    // §S: mode は必須（"local"=channels+agent runtime を本コンテナで動かす／"remote"=外部transport）。
    // 無いと「Gateway start blocked: missing gateway.mode」で起動拒否(exit78)＝実測。
    mode: "local",
    port: 18789, // healthCheck(fargate.tf)が叩く 18789 に明示一致させる
    bind: "loopback", // 0.0.0.0 へは絶対に出さない。管理は SSH/Tailscale。
    // Operator terminal はgateway process環境を含むshell能力なので明示的に無効化。
    terminal: { enabled: false },
    // 共有 gateway secret は full operator scope 相当＝root 級。値は注入し、loopback+ファイル perm で守る。
    auth: { token: "${OPENCLAW_GATEWAY_TOKEN}" },
  },

  // ── MCP（外部 stdio ではなく streamable-http で creds 分離） ─────────────────
  mcp: {
    servers: {
      teamagent: {
        // Fargate: Cloud Map private DNS（fargate.tf の service_discovery と一致）。docker-compose ローカルは "teamagent-mcp"。
        url: "http://teamagent-mcp.teamagent.internal:8787/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${TEAMAGENT_MCP_BEARER}" }, // 値は注入
        // video_algorithm（同期・5〜10本の TikTok 動画 DL+ffmpeg+Gemini 分析）が
        // 60s では完走できず report_url/slides_url が返らない問題への対応で 300s に延長。
        // 全ツール共通の上限（天井）＝通常の高速ツールには無影響。本数は MCP の
        // VIDEO_ALGO_MAX_VIDEOS と整合させること（10本の重い回は 300s に迫り得る＝将来は非同期化）。
        timeout: 300,
        // Effective scopeはinfra/openclaw/effective-tool-scope.jsonが副作用分類の正。
        // 会社データ読取に加え、Gmail下書き保存(mail_reply/mail_draft/schedule_propose)、
        // 本人Calendar書込(calendar_event・招待なし)、Slackファイル配信(knowledge_deliver)、
        // 外部job/S3 report生成も含む。メール送信・招待送信・Drive書込は許可しない。
        // ※ tiktok_search/video_analysis/video_algorithm は MCPツール（factory: USE_VIDEO_TOOLS/
        //   USE_TIKTOK_TOOLS=1）として金庫内で実行＝OpenClaw自身は native exec/browser を使わない（§L）。
        //   これらを include する前に、MCPバックエンド側で当該 env flag を ON にすること。
        toolFilter: {
          include: [
            "search", "clientkarte", "proposal_draft", "proposal_review",
            // proposal_builder: Gemini v3 JSON + 投稿開始日Dから、既存RAG/95枠rendererを
            // 再利用して統合PPTXを生成し、検証済み依頼元へ添付。USE_PROPOSAL_BUILDER_TOOLS=1、
            // 代表143MB E2Eの実測attestation、S3固定version資産、media workerが全て必要。
            "proposal_builder",
            "tiktok_search", "video_analysis", "video_algorithm",
            // ③動画チェック: 自社編集者の納品動画をオリエンと照合し合否/誤植/尺の一次FB。
            //   現在は scope enabledBy=never。解禁4点セットは (1) tf task env 配線、
            //   (2) scope enabledBy 更新、(3) contract test 更新、(4) OCイメージ再ビルド。
            //   MCP側の USE_VIDEO_APPROVAL=1 だけでは解禁しない。video_analysis(外部競合分析)と棲み分け。
            "video_approval",
            // operation_log: Slackスレッド営業会話→CRM転記用構造化（USE_OPERATION_LOG_TOOLS=1 で MCP側に出る）。
            //   現在は scope enabledBy=never。解禁時は tf task env + scope enabledBy +
            //   contract test + OCイメージ再ビルドの4点を同じ変更単位で揃える。
            "operation_log",
            // §U-PartA-Step A: メール機能（readonly 3つ）を mention 経由で公開（@AiLa メール要約・要返信トリアージ・社内資料横断）。
            // per-user OAuth(本人受信箱)で動作・DLPマスク後 Bedrock 要約（mail_summary/skill.py の G1-G7 死守）。
            "mail_summary", "mail_followup", "mail_to_internal_context",
            // §U-Part3-Step C: 返信下書き生成も公開（gmail.modify drafts.create のみ・送信は人間が手動）。
            // mail_reply.skill.py の G4' で send/delete は denylist 物理封鎖（コードで保証）。
            "mail_reply",
            // 朝ダイジェストの「✏️下書きを作成」ボタン押下処理。OpenClaw が interaction を system
            // event でエージェントへ渡し、SOUL 指示で本ツールを呼ぶ（draft_token を検証→Reply-All
            // 下書き作成・送信しない）。USE_MAIL_DRAFT_TOOL=1 が必要。
            "mail_draft",
            // v0.3 Task3: 📅カレンダー登録ボタン（本人カレンダーのみ・招待送信なし・既定OFFのenv gateあり）
            "calendar_event",
            // v0.3 Task4: 🗓日程候補提案ボタン（候補入り下書き＋透明仮予定・送信/招待なし・既定OFF）
            "schedule_propose",
            // morning_digest は EventBridge Scheduled Taskに加えてmention-capable MCPにもincludeされる。
            // MCP taskはDRAFT_ON_DEMAND_ONLY=trueを必須化し、mentionからの自動Gmail draftを拒否する。
            // USE_MORNING_DIGEST_TOOL=1 が必要。
            "morning_digest",
            // §U: oauth_connect — @AiLa「連携」で本人専用の Google 認可 URL を返す。
            // OpenClaw に connect 経路が無い問題への対応。URL生成のみ（token保存は connect-web）。
            // USE_OAUTH_CONNECT_TOOL=1 + OAUTH_REDIRECT_URI/OAUTH_STATE_SECRET/CONNECT_GOOGLE_* が必要。
            "oauth_connect",
            // knowledge_deliver: 「資料そのものを出して」系で該当ファイルを依頼者 DM に添付配信
            // （USE_KNOWLEDGE_DELIVER=1 で MCP 側に出る）。検索+読取DLのみ・Drive書込なし。
            "knowledge_deliver",
            // knowledge_search_url: @AiLa「検索ページ教えて」で資料検索 Web UI（connect-web の
            // /search・/search/graph）の URL を返す。URL生成のみ（CONNECT_BASE_URL 未設定なら
            // 「未公開」を返し壊れたリンクは出さない）。現在は scope enabledBy=never。
            // 解禁4点セット: tf task env / scope enabledBy / contract test / OCイメージ再ビルド。
            // USE_KNOWLEDGE_SEARCH_URL_TOOL=1 の単独設定では解禁しない。
            "knowledge_search_url",
            // tiktok_acquire: TikTok取得の非同期ジョブ（SQS→使い捨てFargate）。search_surface_check
            // と video_algorithm の取得段。USE_TIKTOK_ACQUIRE=1 + tiktok_acquire.tf apply が必要。
            "tiktok_acquire", "tiktok_acquire_status",
            // カタログ①②④: X(Twitter)リサーチ（声集め/ニーズ発掘/効果測定）。
            // USE_X_RESEARCH_TOOLS=1 + APIFY_API_TOKEN + （④は x_research.tf apply）が必要。
            // 段階公開は X_RESEARCH_ALLOWED_EMAILS（skill層 gate・空=全員）。
            "x_voice_search", "x_needs_mining", "x_buzz_measure", "x_buzz_measure_status",
            // カタログ③: 検索面チェック（TikTok×IG媒体比較・勢力図・在圏判定）。
            // USE_SEARCH_SURFACE_TOOL=1 + APIFY_API_TOKEN が必要。
            "search_surface_check",
            // カタログ⑤: コメント欄マイニング（chromium一次→Apify縮退・Bedrock分類）。
            // USE_TIKTOK_COMMENT_TOOLS=1 が必要。
            "tiktok_comment_mining",
          ],
          // 未レビューの重操作・確定系を明示除外（許可する副作用は上のincludeで個別列挙）。
          // ※ L2 run_agent（MCP: USE_AGENT_ORCHESTRATOR=1 で露出する適応オーケストレーター）は
          //   この include に **意図的に入れない**＝パイロット中は dark。OpenClaw 自身がオーケスト
          //   レーションの外殻なので二重オーケストレーションを避ける。解禁はパイロット後に別途判断（§L C2）。
          // 台帳外6本（SkillRegistryには実在）を明示 exclude:
          // chitchat / recommend / proposal_campaign / mail_constraints / workspace_search /
          // proposal_deck。前3本も暗黙の include 非掲載にせず、棚卸し対象としてここに残す。
          // *reply* / *write* ワイルドカードは Step C で外し、include の明示許可リスト（mail_reply）に置き換え。
          exclude: [
            "chitchat", "recommend", "proposal_campaign",
            "mail_constraints", "workspace_search", "proposal_deck", "*confirm*",
          ],
        },
      },
    },
  },

  // ── モデルプロバイダ：Amazon Bedrock（IAM/aws-sdk・APIキー不要） ───────────
  models: {
    providers: {
      "amazon-bedrock": {
        baseUrl: "https://bedrock-runtime.ap-northeast-1.amazonaws.com", // 東京
        api: "bedrock-converse-stream",
        auth: "aws-sdk", // ← APIキー無し。インスタンスロール / 既定資格情報チェーン。
        // §S: discovery は v2026.6.1 schema の provider に無い（config validate で弾かれた）ため削除。
        // models[] を明示しているので discovery(ListFoundationModels) は元々不要＝最小権限のまま。
        // §P: id は list-inference-profiles 実測値（2026-06-11・東京）。Sonnet4.6 はサフィックス無し。
        models: [
          {
            id: "jp.anthropic.claude-haiku-4-5-20251001-v1:0", // §D: 外側ループ既定（速い・安い）
            name: "Claude Haiku 4.5 (Bedrock Tokyo)",
            reasoning: false,
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 8192,
          },
          {
            id: "jp.anthropic.claude-sonnet-4-6", // 重い処理用（任意・通常は MCP 側 L2 が使用）
            name: "Claude Sonnet 4.6 (Bedrock Tokyo)",
            reasoning: true,
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
}
