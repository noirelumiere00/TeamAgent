{
  "schemaVersion": 1,
  "profile": "teamagent-openclaw-production-v1",
  "sharedCliPath": "/opt/teamagent/trusted-release/bin/trusted-release",
  "sharedContractPath": "/opt/teamagent/trusted-release/contracts/teamagent-openclaw-production-v1.json",
  "target": {
    "awsAccountId": "718959508629",
    "region": "ap-northeast-1",
    "repository": "718959508629.dkr.ecr.ap-northeast-1.amazonaws.com/teamagent-openclaw",
    "cluster": "teamagent-dev",
    "service": "teamagent-dev-openclaw",
    "taskFamily": "teamagent-dev-openclaw",
    "taskRoleArn": "arn:aws:iam::718959508629:role/teamagent-dev-openclaw-task",
    "executionRoleArn": "arn:aws:iam::718959508629:role/teamagent-dev-ecs-exec-openclaw",
    "appArtifact": {
      "bucket": "teamagent-dev-raw-files",
      "key": "codebuild/connect-web-app.html",
      "requiredAnchors": [
        "appHtmlSha256",
        "manifestSha256",
        "buildInputsSha256",
        "dataSha256"
      ]
    }
  },
  "source": {
    "statementRelativePath": ".trusted-release/source-statement.json",
    "repositoryUri": "https://github.com/noirelumiere00/teamagent",
    "codeBuildProjectArnPrefix": "arn:aws:codebuild:ap-northeast-1:718959508629:build/teamagent-dev-openclaw-image-builder:",
    "requireSignedPublisherStatement": true,
    "requireCommitArchiveBinding": true,
    "requireSourceRootReverificationAtPromotion": true,
    "requireExactBuildContextClosure": true,
    "allowUnsignedS3Metadata": false,
    "allowArbitraryS3Zip": false,
    "allowBuilderProducedVerificationBooleans": false
  },
  "promotion": {
    "authorityBoundary": "out-of-process-shared-worker",
    "builderRoleMayAuthenticateOrWriteRegistry": false,
    "builderRoleMayAssumePromotionRole": false,
    "canonicalTagPrefix": "git-",
    "quarantineTagPrefix": "quarantine-openclaw-",
    "requireLocalGatesBeforeQuarantine": true,
    "requireAllTestsAndScansBeforeCanonicalTag": true,
    "requireExactSubjectPromotion": true,
    "requiredPlatform": "linux/arm64",
    "requiredPlatformManifestCount": 1,
    "requireImmutableCanonicalTag": true,
    "requireAtomicSubjectAndReferrers": true,
    "requireIdempotentApprovedReleaseRetry": true,
    "forbidDeleteForRetry": true,
    "requireWholeFilesystemSbomExactEquivalence": true,
    "requireExactMaterialSet": true,
    "requireAllEvidenceFilesIndexedAndSigned": true,
    "requiredReferrers": [
      "wholeFilesystemCycloneDx",
      "provenance",
      "imageSignature",
      "evidenceIndexSignature"
    ]
  },
  "deploymentReceipt": {
    "maxAgeSeconds": 900,
    "oneTime": true,
    "requireAtomicConsume": true,
    "requireDurablePreviousTaskDefinitionArn": true,
    "requireCircuitBreakerRollbackIntent": true,
    "requirePostStableSlackBedrockMcpCanaryIntent": true,
    "requireDurableSignedCanaryResult": true,
    "requiredScanStatus": {
      "status": "PASS",
      "platform": "linux/arm64",
      "platformManifestCount": 1,
      "critical": 0,
      "high": 0,
      "secrets": 0,
      "knownLiveFindingIdsAbsent": [
        "CVE-2026-12087",
        "CVE-2026-13221",
        "CVE-2026-33845",
        "CVE-2026-34182",
        "CVE-2026-42010",
        "CVE-2026-55200",
        "CVE-2026-57433",
        "CVE-2026-6100"
      ]
    },
    "requiredBindings": [
      "awsAccountId",
      "repository",
      "imageManifestDigest",
      "sourceCommit",
      "sourceArchiveSha256",
      "buildIdentity",
      "wholeFilesystemSbomDigest",
      "provenanceDigest",
      "imageSignatureDigest",
      "referrerSetDigest",
      "evidenceIndexDigest",
      "scanStatus",
      "platform",
      "platformManifestCount",
      "knownLiveFindingIdsAbsent",
      "appS3VersionId",
      "appHtmlSha256",
      "manifestSha256",
      "buildInputsSha256",
      "dataSha256",
      "taskFamily",
      "service",
      "currentTaskDefinitionArn",
      "currentTaskDefinitionSha256",
      "previousTaskDefinitionArn",
      "registrationPayloadSha256",
      "deploymentIntent",
      "deploymentPlanDigest",
      "circuitBreakerRollbackIntent",
      "postStableCanaryIntent"
    ]
  }
}
