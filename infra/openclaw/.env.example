# これは「変数名だけ」のサンプル。★ 実際の値は絶対にコミットしない（Secrets Manager から注入）。
# docker compose は値を持たず、起動環境（EC2 ロール + secret 注入）から参照する想定。

# OpenClaw ⟷ teamagent-mcp の共有 bearer（両サービスに同じ値を Secrets から注入）
TEAMAGENT_MCP_BEARER=

# Slack event由来callerを1 requestへ束縛する専用HMAC鍵（bearerと別・32-byte以上）
TEAMAGENT_CALLER_CLAIM_SECRET=

# MCP container only: cluster-wide one-use Slack caller claim nonce ledger.
TEAMAGENT_CALLER_CLAIM_REPLAY_TABLE=teamagent-dev-mcp-caller-claim-nonces

# OpenClaw gateway 管理トークン（full operator scope 相当＝root 級に扱う）
OPENCLAW_GATEWAY_TOKEN=

# Slack（Socket Mode）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_TEAM_ID=

# pin 済み TeamAgent バックエンドイメージ（build/push 後に digest 付きで指定）
TEAMAGENT_MCP_IMAGE=

# Bedrock は IAM(aws-sdk)。鍵は置かずインスタンス/タスクロールを使う。リージョンのみ明示。
AWS_REGION=ap-northeast-1
