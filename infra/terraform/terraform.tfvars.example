# ============================================================
# TeamAgent v3.0 — Terraform 変数値テンプレート
# ============================================================
# cp terraform.tfvars.example terraform.tfvars
# して値を埋めてから terraform plan / apply
# ============================================================

aws_region   = "ap-northeast-1"
environment  = "dev"
project_name = "teamagent"

# RDS（dev デフォルト：db.t4g.micro + 20GB ≒ $15/月）
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_engine_version    = "16.14"
db_username          = "teamagent"
db_name              = "teamagent"
db_multi_az          = false             # 本番 = true 推奨

# Lambda / Bedrock（東京リージョン推論プロファイル）
bedrock_model_id   = "jp.anthropic.claude-sonnet-4-6"
lambda_memory_size = 1024
lambda_timeout     = 300
