# ============================================================
# TeamAgent v3.0 — Terraform 変数値テンプレート
# ============================================================
# cp terraform.tfvars.example terraform.tfvars
# して値を埋め、infra/deploy/terraform_runtime_guard.sh にだけ渡す。
# ============================================================

aws_region   = "ap-northeast-1"
environment  = "dev"
project_name = "teamagent"

# RDS（dev デフォルト：db.t4g.micro + 20GB ≒ $15/月）
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_engine_version    = "16.14"
db_username          = "teamagent"
db_name              = "teamagent"
db_multi_az          = false             # 本番 = true 推奨

# ---- 本番化（インフラ#1,#8・コスト承認＝人手ゲート後に切替）----
# ⚠️ 月額が増えるため別途承認後。承認済みmigrationで上の3行を以下へ差し替える。
# db_instance_class    = "db.r7g.large"  # pgvector 検索の安定レイテンシ用（メモリ大）
# db_multi_az          = true            # フェイルオーバー（概ね月額 2 倍）
# db_allocated_storage = 100             # 取り込み量に応じて拡張

# S3 ライフサイクル（監視#20・既定で有効・成果物の保管コスト最適化）
s3_glacier_transition_days    = 90
s3_noncurrent_expiration_days = 180

# Lambda / Bedrock（東京リージョン推論プロファイル）
bedrock_model_id   = "jp.anthropic.claude-sonnet-4-6"
lambda_memory_size = 1024
lambda_timeout     = 300
