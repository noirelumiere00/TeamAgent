# §T2b 2026-06-22 DM全開放の“もう半分”。OpenClaw slack plugin は dmPolicy:"open" でも
# allowFrom に "*" が無いと列挙ユーザーのみ通す allowlist として gating する（実コード確認）。
# entrypoint(openclaw-entrypoint.sh) が SLACK_DM_ALLOWLIST(=本変数) を allowFrom に注入＝
# "*" で全社内DM開放。空文字だと注入スキップ→焼き込み allowFrom(管理者1名)に戻り無反応になる。
# 空配列[]は「全拒否」なので不可。必ず "*"。データは MCP境界 RLS fail-closed で別途保護。
slack_dm_allowlist = "*"

# §G 会社共有モデルのドメイン（gateway company identity と ingest ACL の単一真実源）
shared_company_domains = "vectorinc.co.jp"

# egress を private 化（bedrock/secrets/kms/ecr/logs interface + s3 gateway）
enable_vpc_endpoints = true

# openclaw_model_id は variables_fargate.tf default が実測値済みのため省略。
# 柱2(2026-06-22): アラート通知先を配線。これが空[]だと全 alarm が「通知先未設定で宙に消える」
# （今回の無音失敗の一因）。apply 後に SNS 購読承認メールが届くので承認すること。
# ⚠️ 宛先は運用担当に合わせて要確認（暫定で管理者を設定）。
alarm_email_endpoints = ["s-komata@vectorinc.co.jp"]

# §Q-Q2 aiia-mcp 退役 (2026-06-18): AI-IA-UAE プロジェクト終了
# - enable_aiia_mcp と aiia_mcp_image 削除（変数定義も aiia_mcp.tf と共に削除）

# §VSEO有効化（2026-06-12・Vertex方式・p2s拡張イメージ）
enable_scrape_tools = true

# §U: 朝ダイジェスト（平日9:30 JST 自動配信）を有効化。EventBridge cron→ECS RunTask→
# per-user に メール要約+下書き+カレンダー を Block Kit DM 配信。対象は RDS oauth_tokens 連携済を動的抽出。
enable_morning_digest = true

# 2026-06-24: テストユーザー2名（mx-ebata / r-kuboki）を停止し本人のみに限定。
# 連携は3名（s-komata + テスト2名）のみのため、対象を s-komata に明示すると実質2名停止。
# ※ 新規連携者も対象外になる点に注意。品質改善(スコープC・PR#139)を本番統合後に "" へ戻す。
morning_digest_users   = ""

# §U: 稼働中リソースの ON スイッチ（本番に既にデプロイ済＝state に存在）。
# これが無いと plan が connect-web/ingest を「削除」しようとする（過去は CLI -var で渡していた）。
# 本番状態と一致させるため tfvars に明記（2026-06-20）。
enable_connect_web     = true
enable_ingest_schedule = true

# 柱3(2026-06-23): 主要経路の合成カナリアを 1h 毎に実行（identity 解決の疎通を自動検知）。
enable_canary_health = true

morning_digest_exclude = "mx-ebata@vectorinc.co.jp,r-kuboki@vectorinc.co.jp"
