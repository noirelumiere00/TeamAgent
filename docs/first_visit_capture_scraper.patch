+// Read source values before normalizeVideo fills missing statistics with zero.
+function captureVideo(v, query, rank, rankSource) {
+  if (!v?.id) return null;
+  const stats = v.stats || {};
+  const author = v.author || {};
+  const authorStats = v.authorStats || v.author_stats || {};
+  const images = v.imagePost?.images ?? v.imagePostInfo?.images;
+  const isPhoto = Array.isArray(images) || v.itemType === 2 || v.aweme_type === 150;
+  const row = {
+    provider_id: String(v.id),
+    url: `https://www.tiktok.com/@${author.uniqueId || "_"}/${isPhoto ? "photo" : "video"}/${v.id}`,
+    kw: query, rank_display: rank, rank_source: rankSource,
+    title: v.desc ?? null,
+    hashtags: Array.isArray(v.textExtra) ? v.textExtra.filter((t) => t.hashtagName).map((t) => t.hashtagName) : [],
+    account_id: author.uniqueId ?? null, account_name: author.nickname ?? null,
+    cover_url: v.video?.cover ?? v.video?.originCover ?? images?.[0]?.imageURL?.urlList?.[0] ?? null,
+    isAd: typeof v.isAd === "boolean" ? v.isAd : typeof v.is_ad === "boolean" ? v.is_ad : null,
+    mediaType: isPhoto ? "photo" : v.video ? "video" : null,
+    imageCount: Array.isArray(images) ? images.length : null,
+    textLanguage: v.textLanguage ?? v.descLanguage ?? null,
+    missingFields: [],
+  };
+  const numbers = {
+    plays: [stats.playCount, "stats.playCount"], likes: [stats.diggCount, "stats.diggCount"],
+    comments: [stats.commentCount, "stats.commentCount"], shares: [stats.shareCount, "stats.shareCount"],
+    saves: [stats.collectCount, "stats.collectCount"],
+    followers: [author.followerCount ?? authorStats.followerCount, "author.followerCount"],
+    create_time: [v.createTime, "createTime"], duration: [v.video?.duration, "duration"],
+  };
+  for (const [field, [value, source]] of Object.entries(numbers)) {
+    row[field] = value == null || value === "" ? null : Number(value);
+    if (!Number.isInteger(row[field]) || row[field] < 0) row[field] = null;
+    if (row[field] == null) row.missingFields.push(source);
+  }
+  return row;
+}
