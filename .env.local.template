# ============================================================
# TeamAgent v3.2 — ローカル開発（Mac から SSM tunnel 経由）テンプレート
# ============================================================
# 用途：開発機の Mac から本番 RDS を叩いて Bot を動作確認する時用。
# 本番 RDS の SG が踏み台 EC2 からしか接続を許可していないため、
# Mac → SSM Port Forwarding → 踏み台 → RDS の経路で接続する。
#
# 本番 EC2 / Lambda デプロイ時には .env.production.template を使う。
#
# Usage:
#   # 1. tunnel を別 Terminal で起動（閉じない）
#   aws ssm start-session \
#       --target i-04fd1f367b454f641 \
#       --document-name AWS-StartPortForwardingSessionToRemoteHost \
#       --parameters '{"host":["<実RDS_endpoint>"],"portNumber":["5432"],"localPortNumber":["15432"]}' \
#       --region ap-northeast-1
#
#   # 2. Bot Terminal で
#   cp .env.local.template .env.local
#   set -a; source .env.local; set +a
#   source scripts/load_secrets.sh
#   python -m teamagent.runtime.slack_bot
#
# 注：.env.local は .gitignore で除外されている。
# ============================================================

# --- アプリケーション全般 ---
APP_ENV=local
LOG_LEVEL=DEBUG

# --- AWS ---
AWS_REGION=ap-northeast-1
# ローカル Mac から AWS API（Bedrock / Secrets Manager / RDS describe）を叩くため
# `aws configure` で profile が設定済みであること

# --- Bedrock（東京推論プロファイル）---
BEDROCK_MODEL_ID=jp.anthropic.claude-sonnet-4-6
BEDROCK_HAIKU_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# --- pgvector / 本番 RDS（SSM tunnel 経由）---
# tunnel が localPortNumber=15432 で開いている前提
RDS_HOST=localhost
RDS_PORT=15432
RDS_USER=teamagent
RDS_DBNAME=teamagent
# SSM tunnel 経由でも RDS 側が SSL を要求する場合は require のまま。
# RDS の parameter group で rds.force_ssl=1 が無効なら disable に下げても良い
RDS_SSL_MODE=require
DB_PASSWORD_SECRET_NAME=teamagent/dev/db_password

PGVECTOR_DIMENSIONS=1024

# --- Embedding ---
EMBEDDING_BACKEND=local_e5

# --- Slack（dev App / Secrets Manager から動的取得）---
SLACK_BOT_TOKEN_SECRET_NAME=teamagent/dev/slack/bot_token
SLACK_APP_TOKEN_SECRET_NAME=teamagent/dev/slack/app_token

# --- Skill 設定 ---
USE_CONTEXTUAL=true              # 本番 RDS の Contextual テーブルを参照
USE_LLM_ROUTER=true              # Haiku 4.5 ベースのルーター

# --- 観測 ---
SENTRY_DSN_SECRET_NAME=teamagent/dev/sentry_dsn
CLOUDWATCH_LOG_GROUP=/teamagent/dev

# --- コスト ---
SONNET_INPUT_USD_PER_MTOK=3.0
SONNET_OUTPUT_USD_PER_MTOK=15.0
HAIKU_INPUT_USD_PER_MTOK=1.0
HAIKU_OUTPUT_USD_PER_MTOK=5.0
