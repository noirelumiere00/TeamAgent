# ============================================================
# TeamAgent v3.0 .gitignore
# ============================================================

# --- Secrets / Environment ---
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.production.template
!.env.local.template
!.env.example
*.pem
*.key
*.p12
*.crt
credentials.json
client_secret*.json
service-account*.json
oauth_tokens/
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Test / coverage ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# --- Jupyter / IPython ---
.ipynb_checkpoints
*.ipynb

# --- Type checkers / linters ---
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# --- Node (if used for HTML editor) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
# TikTok スクレイパは外部依存(puppeteer-core)の再現性が重要なので lock を追跡する
!tools/tiktok_scraper/package-lock.json
!tools/rakko_scraper/package-lock.json
# ラッコ ログインセッション (cookie=認証情報なのでコミット禁止)
tools/rakko_scraper/.userdata/
# Puppeteer専用 Chrome for Testing (大きいバイナリ、各自 npx で取得)
tools/rakko_scraper/chrome/
tools/tiktok_scraper/chrome/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml

# --- Terraform ---
.terraform/
.terraform.lock.hcl
!infra/terraform/.terraform.lock.hcl
infra/terraform/provider-mirror/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.*
!terraform.tfvars.example
tfplan
tfplan*
*.tfplan
*.plan
.terragrunt-cache/
crash.log
crash.*.log

# --- Docker ---
.docker/

# --- Data / runtime artifacts ---
data/proposals/
data/proposal_drive_map.json
data/templates/
*.sqlite
*.sqlite3
*.db
logs/
*.log
tmp/
temp/

# --- pgvector dumps ---
*.dump
*.sql.gz

# --- Local development ---
local/
sandbox/
playground/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Other ---
*.pyc
*.bak
*.tmp
.fuse_hidden*

# --- Eval results (Day 8 Sprint 4-C) ---
# 実行ごとに timestamp 付き JSON が増える、レポジトリ汚染防止
data/eval/results/

# --- VSEO video_algorithm のローカル生成レポート（誤コミット防止） ---
.local_out/

# 動画一次FB審査 Phase2 poller の処理済み永続先
.local_state/

# terraform plan の生成物（バイナリ・state 値混入の恐れ・コミット禁止）
*.tfplan
infra/terraform/tf.plan

# connect-web の Obsidian風 静的HTML（機密ナレッジ埋め込み・git履歴に残さない。
# ビルドzipには含めてイメージへ同梱する）
src/teamagent/connect_web/static/app.html
