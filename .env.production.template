# ============================================================
# TeamAgent v3.2 — 本番環境変数テンプレート
# ============================================================
# このファイルは「本番（東京 RDS + Bedrock + Slack）= EC2 / Lambda が VPC 内
# から直接 RDS に接続する」想定のテンプレート。
#
# **ローカル Mac から本番 RDS を叩く時は .env.local.template** を使うこと。
# （SG が踏み台 EC2 からしか接続を許可していないため、Mac は SSM tunnel 経由）
#
# 実際の値（DB パスワード、Slack トークン、etc）は AWS Secrets Manager から
# 取得する。scripts/load_secrets.sh を `source` して埋めて起動する想定。
#
# Usage:
#   cp .env.production.template .env.production
#   # ▼ 必ず手動で RDS_HOST を実エンドポイントに置換すること
#   # 取得: aws rds describe-db-instances --db-instance-identifier teamagent-dev \
#   #         --query 'DBInstances[0].Endpoint.Address' --output text --region ap-northeast-1
#   set -a; source .env.production; set +a
#   source scripts/load_secrets.sh   # Secrets Manager から動的値を環境変数に展開
#   python -m teamagent.runtime.slack_bot
#
# CLAUDE.md 6-bis：本ファイル自体には実値を書かない。漏洩リスクを下げる。
#
# ⚠️ プレースホルダ記法の罠：
#   bash の `set -a; source .env...; set +a` で読む場合、`<...>` `>` `<` は
#   **シェルがリダイレクト演算子として解釈** して値が壊れる。
#   テンプレでは __XXX__ 形式（bash 安全）を使う。
# ============================================================

# --- アプリケーション全般 ---
APP_ENV=production
LOG_LEVEL=INFO

# --- AWS ---
AWS_REGION=ap-northeast-1
# IAM Role を使うので AccessKey/SecretKey は記載しない（EC2 / Lambda 起動 Role 経由）

# --- Bedrock（東京推論プロファイル）---
# 2026/5 確定：jp.プレフィックスが東京のオンデマンド推論プロファイル
BEDROCK_MODEL_ID=jp.anthropic.claude-sonnet-4-6
BEDROCK_HAIKU_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0

# --- pgvector / 本番 RDS ---
# DATABASE_URL は scripts/load_secrets.sh が組み立てる:
#   postgresql://<RDS_USER>:<secret-manager-password>@<RDS_HOST>:<RDS_PORT>/<RDS_DBNAME>?sslmode=<RDS_SSL_MODE>
#
# ▼ RDS_HOST は cp 後に必ず実値に置換すること（プレースホルダ __RDS_ENDPOINT__ を残すと load_secrets.sh が異常検知して fail する）
# 取得コマンド:
#   aws rds describe-db-instances --db-instance-identifier teamagent-dev \
#       --query 'DBInstances[0].Endpoint.Address' --output text --region ap-northeast-1
RDS_HOST=__RDS_ENDPOINT__
RDS_PORT=5432
RDS_USER=teamagent
RDS_DBNAME=teamagent
RDS_SSL_MODE=require
DB_PASSWORD_SECRET_NAME=teamagent/dev/db_password

PGVECTOR_DIMENSIONS=1024

# --- Embedding ---
# 本番は LocalE5Embedder (multilingual-e5-large) をそのまま使う想定。
# Sprint 4 で Titan Embed v2 と比較 → 移行判断
EMBEDDING_BACKEND=local_e5

# --- Slack（本番 App / Secrets Manager から動的取得）---
SLACK_BOT_TOKEN_SECRET_NAME=teamagent/dev/slack/bot_token
SLACK_APP_TOKEN_SECRET_NAME=teamagent/dev/slack/app_token

# --- Skill 設定 ---
USE_CONTEXTUAL=true              # 本番は Contextual Retrieval テーブルを参照
USE_LLM_ROUTER=true              # Haiku 4.5 ベースのルーター（自然文ルーティング）

# --- 観測 ---
SENTRY_DSN_SECRET_NAME=teamagent/dev/sentry_dsn   # Sprint 2 後半で投入
CLOUDWATCH_LOG_GROUP=/teamagent/dev

# --- Google OAuth (Drive + Gmail) — Sprint 3+ ---
# Secrets Manager に {"client_id","client_secret","refresh_token"} JSON 形式で保管
# 設定方法は scripts/get_google_refresh_token.py 参照
GOOGLE_OAUTH_SECRET_NAME=teamagent/dev/google_oauth

# --- コスト ---
# Bedrock 単価（USD/1M tokens）— BedrockClient.usage.cost_usd の計算に利用
# 価格表は適宜更新（2026/5/22 時点）
SONNET_INPUT_USD_PER_MTOK=3.0
SONNET_OUTPUT_USD_PER_MTOK=15.0
HAIKU_INPUT_USD_PER_MTOK=1.0
HAIKU_OUTPUT_USD_PER_MTOK=5.0
